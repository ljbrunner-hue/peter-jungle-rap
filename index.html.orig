  function wxv(k,d){ var w=WX[world]; return w&&w[k]!==undefined?w[k]:d; }
  var WBPM=[0,8,-6,-4,2,-10,6,-2,10,4,-8,12,8], WTR=[0,3,-3,2,-2,-5,-1,4,5,1,-4,3,0], worldPage=0;
