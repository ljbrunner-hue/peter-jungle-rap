          ctx.beginPath(); ctx.moveTo(cx0,top); ctx.lineTo(cx0+Math.cos(a0)*900,top+Math.sin(a0)*900); ctx.lineTo(cx0+Math.cos(a1)*900,top+Math.sin(a1)*900); ctx.closePath(); ctx.fill(); }
        ctx.fillStyle='rgba(0,0,0,.35)'; ctx.fillRect(-20,-20,W+40,GROUND+20);
