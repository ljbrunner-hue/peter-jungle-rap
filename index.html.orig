        ctx.strokeStyle='rgba(0,0,0,.28)'; ctx.lineWidth=1.5; var off=(dist*0.3)%48;
        for(var row=0;row*22<GROUND;row++){ var yy=row*22; ctx.beginPath(); ctx.moveTo(-20,yy); ctx.lineTo(W+20,yy); ctx.stroke(); for(var cx2=-off-(row%2)*24;cx2<W+48;cx2+=48){ ctx.beginPath(); ctx.moveTo(cx2,yy); ctx.lineTo(cx2,yy+22); ctx.stroke(); } }
        scrollI(0.3,300,function(x,idx){
