        var FC=['#e0302a','#ffd23f','#2a7ae0','#3ab04a']; for(i=0;i<14;i++){ var fx=i*(W/13), fy=30+Math.sin(Math.PI*i/13)*30; ctx.fillStyle=FC[i%4]; ctx.beginPath(); ctx.moveTo(fx-8,fy); ctx.lineTo(fx+8,fy); ctx.lineTo(fx,fy+16); ctx.closePath(); ctx.fill(); }
        scrollI(0.2,26,function(x,idx){ var hy=GROUND-36+Math.sin(t*4+idx)*2*(hash(idx)>0.7?1:0); ctx.fillStyle='rgba('+(40+hash(idx)*60|0)+','+(20+hash(idx+1)*40|0)+','+(50+hash(idx+2)*60|0)+',.9)'; ctx.beginPath(); ctx.arc(x,hy,10,0,7); ctx.fill(); ctx.fillRect(x-12,hy+8,24,30); });
