  function goWorld(){ worldPage=Math.floor((world-1)/3); go('world','w'+world); }
  function mkSpecial(s){
    var k=s.k; if(s.alt&&Math.random()<0.4){ s=s.alt; k=s.k; }
    if(k==='drop') return {k:'drop',sp:s.s,w:30,h:30,r:15,fy:Math.max(120,GROUND-30),vf:0};
    if(k==='gap') return {k:'gap',w:78+Math.random()*36,h:8};
    if(k==='tramp') return {k:'tramp',w:58,h:12,safe:1};
    var hi=Math.random()<0.5; return {k:'proj',sp:s.s,fy:hi?96:52,fy0:hi?96:52,r:16,w:32,h:32,bob:s.bob?Math.random()*6:undefined};
  }
  function maxJ(){ return wxv('jumps',0)||(diff===DIFFS[0]?2:1); }

