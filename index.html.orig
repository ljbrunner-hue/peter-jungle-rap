        bR(-20,GROUND-2,W+40,4,'#4a3a5a',1);
      }},
    12:{back:function(pal){
        var i, off=(dist*0.1)%40; ctx.fillStyle='rgba(255,255,255,.35)';
        for(var x=-off;x<W+40;x+=40) ctx.fillRect(x,0,14,GROUND);
        var wx2=((W*0.6-dist*0.05)%(W*1.5)+W*1.5)%(W*1.5)-W*0.3; bR(wx2-80,40,160,130,'#ffffff',4); bR(wx2-72,48,144,114,'#8fd3ff',2);
        ctx.fillStyle='rgba(255,255,255,.9)'; ctx.beginPath(); ctx.ellipse(wx2-30,90,24,9,0,0,7); ctx.ellipse(wx2+30,120,20,8,0,0,7); ctx.fill(); bL('#ffffff',4,[wx2,48,wx2,162]); bL('#ffffff',4,[wx2-72,105,wx2+72,105]);
        bR(wx2-96,34,26,148,'#ff8ab8',6); bR(wx2+70,34,26,148,'#ff8ab8',6);
        scrollI(0.18,360,function(x,idx){ var sy=GROUND-150; bR(x-90,sy,180,10,'#a8784a',2); bR(x-90,sy+80,180,10,'#a8784a',2); bR(x-94,sy,8,150,'#8a5a32',2); bR(x+86,sy,8,150,'#8a5a32',2);
          bR(x-70,sy-28,22,28,'#e0302a',2); bR(x-44,sy-40,20,40,'#2a7ae0',2); bR(x-20,sy-22,24,22,'#3ab04a',2); bC(x+40,sy-16,16,'#ffd23f'); bE(x+40,sy-20,6,4,'#fff');
          for(var k=0;k<5;k++) bR(x-80+k*18,sy+46,14,34,['#d02a2a','#3a7ad8','#ffd23f','#7ad84a','#c85aff'][k],1); });
        scrollI(0.4,230,function(x,idx){ var k=hash(idx); var by=GROUND-46; if(k<0.5){ bR(x-23,by,46,46,['#ff6a5a','#5ab0ff','#ffd23f'][idx%3],5); ctx.font='700 30px "Fredoka","Trebuchet MS",sans-serif'; ctx.textAlign='center'; ctx.fillStyle='rgba(255,255,255,.85)'; ctx.fillText('ABC'.charAt(idx%3),x,by+34); } });
      }, ground:function(pal){
        plainGround(pal,8); ctx.strokeStyle=pal.dirt2; ctx.lineWidth=1.5;
        for(var j=0;j<3;j++){ var yy=GROUND+8+j*22; ctx.beginPath(); ctx.moveTo(-20,yy); ctx.lineTo(W+20,yy); ctx.stroke(); }
        scrollI(1,140,function(x,idx){ for(var j=0;j<3;j++){ var xx=x+((j*53)%140); ctx.beginPath(); ctx.moveTo(xx,GROUND+8+j*22); ctx.lineTo(xx,GROUND+30+j*22); ctx.stroke(); } });
        scrollI(1,520,function(x,idx){ bR(x,GROUND+12,300,Hw-GROUND,'rgba(200,60,90,.35)',10); ctx.strokeStyle='rgba(255,220,120,.6)'; ctx.setLineDash([6,5]); ctx.strokeRect(x+8,GROUND+18,284,Hw-GROUND); ctx.setLineDash([]); });
      }},
    13:{back:function(pal){
        var i, cx0=W/2, top=-60;
