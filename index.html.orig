  function readBest(w,i){ try{ return +localStorage.getItem(w===1?'peterBest'+i:'peterBestW'+w+'_'+i)||0; }catch(e){ return 0; } }
  function loadBests(){ for(var i=0;i<3;i++) bests[i]=readBest(world,i); }
  function setWorld(w){ world=w; LEVELS=WORLDS[w-1]; loadBests(); }

