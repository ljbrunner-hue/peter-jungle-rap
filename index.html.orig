  /* Welt-Missionen: jede Welt in jeder Schwierigkeit einmal schaffen (1-3 Bananen) */
  (function(){ for(var w=1;w<=WNAMES.length;w++) for(var d=0;d<3;d++)
    MAIN.push({id:'cw'+w+'_'+d,grp:'w',t:'Welt '+w+' · '+DIFFS[d].name,d:'Schaffe '+WNAMES[w-1]+' auf '+DIFFS[d].name,k:'clr'+w+'_'+d,m:'sum',n:1,b:50+10*(w-1)+50*d}); })();
  /* Belohnungen: einfache Missionen 1-3 (je nach Schwierigkeit), Stern-Missionen 5 */
  (function(){
    var RB={m1:1,m2:1,m3:1,m4:1,m5:2,m6:2,m7:2,m8:2,m9:2,m10:3,m11:3,m12:3,m13:3,m14:3,h1:5,h2:5,h3:5,h4:5,h5:5,h6:5,
            d1:1,d2:2,d3:1,d4:2,d5:1,d6:1,d7:2,d8:1,d9:3};
    MAIN.forEach(function(m){ if(RB[m.id]) m.b=RB[m.id]; }); DPOOL.forEach(function(m){ if(RB[m.id]) m.b=RB[m.id]; });
  })();
  /* Fortschritt: welche Welt pro Schwierigkeit freigeschaltet bzw. geschafft ist */
  var PROG={u:[1,1,1],c:{}}, misTab=0;
  try{ var pg0=JSON.parse(localStorage.getItem('peterProg')||'null'); if(pg0&&pg0.u) PROG=pg0; }catch(e){}
  (function(){ /* bereits gewonnene Welten aus alten Spielständen übernehmen */
    for(var w=1;w<=WNAMES.length;w++) for(var d=0;d<3;d++){
      var bb=0; try{ bb=+localStorage.getItem(w===1?'peterBest'+d:'peterBestW'+w+'_'+d)||0; }catch(e){}
      if(bb>=STEP*NLV){ PROG.c[w+'_'+d]=1; PROG.u[d]=Math.max(PROG.u[d],Math.min(WNAMES.length,w+1)); }
    } })();
  function saveProg(){ try{ localStorage.setItem('peterProg',JSON.stringify(PROG)); }catch(e){} }
  function isUnl(w,d){ return w<=PROG.u[d]; }
  function worldOpen(w){ return isUnl(w,0)||isUnl(w,1)||isUnl(w,2); }
  function isClr(w,d){ return !!PROG.c[w+'_'+d]; }
  function worldDone(w,d){
    var first=!PROG.c[w+'_'+d]; PROG.c[w+'_'+d]=1;
    if(w<WNAMES.length&&PROG.u[d]<w+1){ PROG.u[d]=w+1; pop(W/2,Hw*0.5-50,'Welt '+(w+1)+' freigeschaltet ('+DIFFS[d].name+')!','#8fd3ff',20,3); }
    saveProg(); if(first) addStat('clr'+w+'_'+d,1);
  }
  function tryStart(i){ if(!isUnl(world,i)){ menuMsgShow('Gesperrt: Schaffe zuerst Welt '+(world-1)+' auf '+DIFFS[i].name); return; } startGame(i); }
  function lockIcon(x,y,s,col){ col=col||'#fff'; ctx.strokeStyle=col; ctx.lineWidth=s*0.22; ctx.beginPath(); ctx.arc(x,y-s*0.35,s*0.38,Math.PI,0); ctx.stroke(); bR(x-s*0.55,y-s*0.35,s*1.1,s*0.85,col,s*0.15); bC(x,y+s*0.05,s*0.12,'#26200f'); }
  var MS={prog:{},done:{}}, DS=null, UNL={trail:[0,0,0],shot:[0,0],dance:0}, trailSel=0, shotSel=0;
  try{
    var ms0=JSON.parse(localStorage.getItem('peterMis')||'null'); if(ms0&&ms0.prog) MS=ms0;
    var ds0=JSON.parse(localStorage.getItem('peterDaily')||'null'); if(ds0&&ds0.ids) DS=ds0;
    var un0=JSON.parse(localStorage.getItem('peterUnl')||'null'); if(un0&&un0.trail) UNL=un0;
    trailSel=+localStorage.getItem('peterTrail')||0; shotSel=+localStorage.getItem('peterShot')||0;
  }catch(e){}
  if(!UNL.trail[trailSel-1]) trailSel=0; if(!UNL.shot[shotSel-1]) shotSel=0;
  function today(){ var d=new Date(); return d.getFullYear()+'-'+(d.getMonth()+1)+'-'+d.getDate(); }
  function ensureDaily(){
    var td=today(); if(DS&&DS.day===td) return;
    var h=0, i, ids=[], pool=DPOOL.map(function(m){ return m.id; });
    for(i=0;i<td.length;i++) h=(h*31+td.charCodeAt(i))>>>0;
    for(i=0;i<3;i++){ h=(h*1103515245+12345)>>>0; ids.push(pool.splice(h%pool.length,1)[0]); }
    DS={day:td,ids:ids,prog:{},done:{}}; misDirty=true;
  }
  function dailyList(){ ensureDaily(); return DS.ids.map(function(id){ for(var i=0;i<DPOOL.length;i++) if(DPOOL[i].id===id) return DPOOL[i]; }); }
  function saveMis(){ misDirty=false; try{ localStorage.setItem('peterMis',JSON.stringify(MS)); if(DS) localStorage.setItem('peterDaily',JSON.stringify(DS)); localStorage.setItem('peterUnl',JSON.stringify(UNL)); localStorage.setItem('peterTrail',trailSel); localStorage.setItem('peterShot',shotSel); }catch(e){} }
  function mProg(m,st){ return Math.min(m.n,st.prog[m.id]||0); }
  function unlock(u){
    if(u==='dance') UNL.dance=1;
    else if(u.indexOf('trail')===0){ var ti=+u.charAt(5); UNL.trail[ti-1]=1; trailSel=ti; }
    else { var si=+u.charAt(4); UNL.shot[si-1]=1; shotSel=si; }
  }
  function misCheck(m,st){
    if(st.done[m.id]||(st.prog[m.id]||0)<m.n) return;
    st.done[m.id]=1; bananas+=m.b; if(inGame()) runBan+=m.b;
    if(m.u) unlock(m.u);
    saveEco(); saveMis();
    var my=Hw*0.5;
    pop(W/2,my,(st===DS?'Tagesmission':'Mission')+' geschafft!','#9be05a',24,2.4);
    pop(W/2,my+24,(st===DS?m.d:m.t)+' · +'+m.b+' Bananen','#ffd23f',16,2.4);
    if(m.u) pop(W/2,my+46,'Freigeschaltet: '+UNAMES[m.u]+'!','#e8a8ff',18,2.8);
  }
  function eachMis(fn){ var i, dl=dailyList(); for(i=0;i<MAIN.length;i++) fn(MAIN[i],MS); for(i=0;i<dl.length;i++) fn(dl[i],DS); }
  function addStat(k,v){ eachMis(function(m,st){ if(m.k!==k||m.m!=='sum'||st.done[m.id]) return; st.prog[m.id]=(st.prog[m.id]||0)+v; misDirty=true; misCheck(m,st); }); }
  function maxStat(k,v){ eachMis(function(m,st){ if(m.k!==k||m.m!=='max'||st.done[m.id]||v<=(st.prog[m.id]||0)) return; st.prog[m.id]=v; misDirty=true; misCheck(m,st); }); }
  function openCount(){ var n=0; eachMis(function(m,st){ if(!st.done[m.id]) n++; }); return n; }
  function cMult(){ return Math.min(10,1+Math.floor(combo/5)); }
  function comboAct(n,p){
    combo+=n; comboT=4; var m=cMult();
    if(m>lastMult) pop(px,p.y-110,'Combo x'+m+'!','#ff9a2e',20+m,0.9);
    lastMult=m; bonus+=p*m; maxStat('combo',m);
  }
  function bossKilled(charged){
    var b=boss;
    addStat('boss',1); if(charged) addStat('chargeKill',1); if((b.ft||0)<30) addStat('fastKill',1);
    maxStat('lvl',b.n); if(diff===DIFFS[2]) maxStat('lvlJW',b.n);
    if(b.final&&!giantUsed) addStat('finalNoGiant',1);
    if(b.n===NLV) addStat('worldClear',1);
    comboAct(3,100);
    if(UNL.dance) danceT=1.3;
  }
  function cycleTrail(d){ var n=trailSel, i; for(i=0;i<4;i++){ n=(n+d+4)%4; if(n===0||UNL.trail[n-1]){ trailSel=n; break; } } saveMis(); }
  function cycleShot(d){ var n=shotSel, i; for(i=0;i<3;i++){ n=(n+d+3)%3; if(n===0||UNL.shot[n-1]){ shotSel=n; break; } } saveMis(); }
  function calcAlmost(){
    var a=[], best=null, br=0;
    if(boss&&boss.phase==='fight'){ var pc=Math.max(1,Math.round(boss.hp/boss.max*100)); if(pc<=40) a.push('Der Boss hatte nur noch '+pc+' % Leben!'); }
    else if(!boss){ var dB=Math.ceil(nextBoss-pts); if(dB<=300) a.push('Nur noch '+fmt(dB)+' Punkte bis zum Boss!'); }
    if(bests[di]>0&&score<bests[di]&&bests[di]-score<=Math.max(400,bests[di]*0.2)) a.push('Nur noch '+fmt(bests[di]-score)+' Punkte bis zu deinem Rekord!');
    eachMis(function(m,st){ if(st.done[m.id]) return; var r=mProg(m,st)/m.n; if(r>=0.6&&r>br){ br=r; best=[m,st]; } });
    if(best&&a.length<2) a.push((best[1]===DS?'Tagesmission':'Mission')+' „'+(best[1]===DS?best[0].d:best[0].t)+'“: '+fmt(mProg(best[0],best[1]))+'/'+fmt(best[0].n)+' – fast!');
    return a.slice(0,2);
  }
  var COSTUMES=['Standard','Rapper','Superheld','Astronaut','Pirat','Ninja','Ritter','Roboter'], PRICE=[0,10,50,100,150,200,250,300], owned=[1,0,0,0,0,0,0,0], plat=[0,0,0,0,0,0,0,0], platOn=[0,0,0,0,0,0,0,0], shopPlat=0, previewPl=-1, costume=0;
  var PU={j:0,d:0,v:0,s:[0,0,0,0,0,0,0,0]}, spCd=0, spShieldT=0, slowT=0, spFlash=0;
  var PUP_J=[20,50,100], PUP_D=[30,75,150], PUP_V=150;
  var SPEC=[{n:'Bananen-Salve',d:'Fächer aus goldenen Bananen'},{n:'Bass-Welle',d:'Schallwelle räumt Hindernisse ab'},{n:'Laserstrahl',d:'Durchschlagender Strahl'},{n:'Schwerkraftfeld',d:'Verlangsamt Welt & Geschosse'},{n:'Kanonenkugel',d:'Schwere Kugel, viel Schaden'},{n:'Wurfsterne',d:'Durchschlagende Sterne'},{n:'Schutzschild',d:'Blockt Treffer'},{n:'EMP-Impuls',d:'Räumt alles ab, schadet dem Boss'}];
  var bananas=0, runBan=0, shopTab=0, shopIdx=0, menuMsg='', menuMsgT=0, dragVol=false;
  try{ for(var bi=0;bi<3;bi++) bests[bi]=+localStorage.getItem('peterBest'+bi)||0; costume=(+localStorage.getItem('peterCostume2')||0)%8; }catch(e){}
  try{ bananas=+localStorage.getItem('peterBananas')||0; var ow=JSON.parse(localStorage.getItem('peterOwned2')||'null'); if(ow&&ow.length===8) owned=ow; var pl=JSON.parse(localStorage.getItem('peterPlat')||'null'); if(pl&&pl.length===8) plat=pl; var po=JSON.parse(localStorage.getItem('peterPlatOn')||'null'); if(po&&po.length===8) platOn=po; var pu=JSON.parse(localStorage.getItem('peterPU')||'null'); if(pu&&pu.s&&pu.s.length===8){ PU=pu; } owned[0]=1; }catch(e){}
  if(!owned[costume]) costume=0; shopIdx=costume;

  /* ===== Musik: Trap-Beat im Deutschrap-Stil + eigener Gesang (Formant-Synthesizer, Web Audio) ===== */
  var music=(function(){
    var ac=null, master=null, comp=null, echo=null, noiseBuf=null, timer=0, nextT=0, step=0, on=false, paused=false, muted=false, lastKey=null, VOL=0.5, VOUT=2.4, vol=0.7;
    var lineText='', lineAt=0, lineHook=false, voice=null, voices=[], vIdx=0, ducked=false, duckTimer=0, voiceEndMs=0, savedVoice='', api=null, vo={}, vMode=0;
    var synth=window.speechSynthesis, canSpeak=!!(synth&&window.SpeechSynthesisUtterance);
    var canSing=!!(window.AudioContext||window.webkitAudioContext);
    try{muted=localStorage.getItem('peterMute')==='1'}catch(e){}
    try{ var vv0=localStorage.getItem('peterVol'); if(vv0!==null) vol=Math.max(0,Math.min(1,+vv0)); }catch(e){}
    try{ var vm=localStorage.getItem('peterVoiceMode'); if(vm!==null) vMode=(+vm)||0; }catch(e){}
    try{savedVoice=localStorage.getItem('peterVoiceName')||''}catch(e){}
    if(vMode<0||vMode>2) vMode=0;
    if(vMode===1&&!canSpeak) vMode=0;

    /* Eigener Text: Der Hook bleibt, alles andere ist neu und kinderfreundlich */
    var H='Lass die Affen aus dem Zoo!', H2='Lass die Affen aus dem Zoo, hey!', HOOKSTART='Lass die Affen aus dem Zoo';
    var V1=['Ich bin Peter, kleiner Affe, doch mein Flow ist riesengroß,',
            'ich spring\' über Feuer und Reifen und flieg\' vom Boden los.',
            'Mit der Kappe auf dem Kopf und der Kette aus Gold,',
            'jeder Boss wird besiegt, weil Peter das so wollt\'.'];
    var V2=['Springen, Ladeattacke, goldene Banane in der Hand,',
            'der schnellste Affe überhaupt, bekannt im ganzen Land.',
            'Schlange, Krokodil und Spinne, der Tiger hält nicht stand,',
            'Papagei und Nashorn fallen, ich hab\' sie schnell erkannt.'];
    var V3=['Skorpion und Elefant, die schaffen mich nicht heut\',',
            'ich sammle goldene Bananen, das hat mich stets gefreut.',
            'Feuerdrache speit die Glut, doch ich bleibe cool,',
            'zehn Level, ein Gorilla, ich spring\' in den Dschungelpool.'];
    var VB=['Der Boss ist riesig, doch ich hab\' keine Angst,',
            'ich halte die Taste und lade, bis du staunst.',
            'Goldene Banane, Mega-Schlag, bumm, das knallt,',
            'der Boss ist k.o., und der Dschungel hallt.'];

    var RUN={bpm:140, roots:[33,29,31,28],
      kick:[[0,10],[0,3,10],[0,6,10],[0,3,7,10,14]],
      mel:[69,0,0,0,0,0,72,0, 0,0,76,0,0,0,72,0,  65,0,0,0,0,0,69,0, 0,0,72,0,0,0,69,0,
           67,0,0,0,0,0,71,0, 0,0,74,0,0,0,71,0,  64,0,0,0,0,0,68,0, 0,0,71,0,0,0,68,0],
      lines:['','',H,H,H,H2, V1[0],'',V1[1],'',V1[2],'',V1[3],'', H,H,H,H2,
             V2[0],'',V2[1],'',V2[2],'',V2[3],'', H,H,H,H2, V3[0],'',V3[1],'',V3[2],'',V3[3],'', H,H,H,H2]};
    var BOSS={bpm:150, roots:[33,33,31,28],
      kick:[[0,2,7,10,12],[0,3,6,10,12,14],[0,2,7,10,12],[0,3,6,8,10,12,14,15]],
      mel:[69,0,0,72,0,0,76,0, 0,72,0,0,69,0,0,0,  65,0,0,69,0,0,72,0, 0,69,0,0,65,0,0,0,
           67,0,0,71,0,0,74,0, 0,71,0,0,67,0,0,0,  64,0,0,68,0,0,71,0, 0,68,0,0,64,0,0,0],
      lines:[H,H,H,'Hey, hey, hey!', VB[0],'',VB[1],'',VB[2],'',VB[3],'', H,H,H,H2]};
    /* Jedes Level klingt anders: andere Tonart und anderes Tempo */
    var TRANS=[0,-2,3,5,-4,2,-1,1,-3,0], BPMADD=[0,-4,2,6,-2,0,4,2,8,6];

    function hz(m){ return 440*Math.pow(2,(m-69)/12); }
    function vs(){ return vol/0.7; }
    function env(g,at,a,v,d){ g.gain.setValueAtTime(0.0001,at); g.gain.exponentialRampToValueAtTime(v,at+a); g.gain.exponentialRampToValueAtTime(0.0001,at+d); }
    function tone(type,f,at,v,d,fEnd,dest){
      var o=ac.createOscillator(), g=ac.createGain(); o.type=type; o.frequency.setValueAtTime(f,at);
      if(fEnd) o.frequency.exponentialRampToValueAtTime(fEnd,at+d*0.8);
      env(g,at,0.004,v,d); o.connect(g); g.connect(dest||master); o.start(at); o.stop(at+d+0.05);
    }
    function noise(at,type,f,v,d){
      var s=ac.createBufferSource(), fl=ac.createBiquadFilter(), g=ac.createGain();
      s.buffer=noiseBuf; fl.type=type; fl.frequency.value=f;
      env(g,at,0.002,v,d); s.connect(fl); fl.connect(g); g.connect(master); s.start(at); s.stop(at+d+0.05);
    }
    function kick(at,v){ tone('sine',165,at,v,0.3,44); noise(at,'lowpass',900,v*0.12,0.012); }
    function sub(at,m,d,v){ var f=hz(m); tone('sine',f*1.3,at,v,d,f); tone('triangle',f*2,at,v*0.18,d*0.5); }
    function clap(at,v){ noise(at,'bandpass',1500,v*0.5,0.02); noise(at+0.011,'bandpass',1500,v*0.6,0.02); noise(at+0.022,'bandpass',1400,v,0.15); }
    function hat(at,v,d){ noise(at,'highpass',8000,v,d); }
    function pluck(m,at,v){ tone('triangle',hz(m),at,v,0.38); tone('sine',hz(m)*2,at,v*0.35,0.2); if(echo) tone('triangle',hz(m),at,v*0.5,0.38,0,echo); }
    function stab(at,m,v,d){
      var o=ac.createOscillator(), fl=ac.createBiquadFilter(), g=ac.createGain();
      o.type='sawtooth'; o.frequency.setValueAtTime(hz(m),at); fl.type='lowpass'; fl.frequency.value=700;
      env(g,at,0.005,v,d); o.connect(fl); fl.connect(g); g.connect(master); o.start(at); o.stop(at+d+0.05);
    }
    function pad(at,m,d){
      var ns=[m,m+7,m+12];
      for(var i=0;i<ns.length;i++){
        var o=ac.createOscillator(), fl=ac.createBiquadFilter(), g=ac.createGain();
        o.type='triangle'; o.frequency.setValueAtTime(hz(ns[i]),at); fl.type='lowpass'; fl.frequency.value=650;
        env(g,at,0.35,0.035,d); o.connect(fl); fl.connect(g); g.connect(master); o.start(at); o.stop(at+d+0.05);
      }
    }

    /* =====================================================================
       GESANG: Formant-Synthesizer
       Jede Silbe wird aus Lauten (Vokale mit Formanten, Zischlaute, Verschlusslaute)
       zusammengesetzt, auf ein Rhythmus-Raster gelegt und mit einer Melodie gesungen.
       ===================================================================== */
    /* Vokale: Formanten F1, F2, F3 in Hz (männliche Stimme) */
    var VOW={'a':[700,1220,2600],'a:':[700,1220,2600],'E':[560,1800,2550],'E:':[500,1900,2600],'e:':[400,2100,2650],'e':[400,2100,2650],
      'i:':[280,2250,2900],'i':[300,2200,2900],'I':[400,1950,2600],'o:':[430,800,2600],'o':[430,800,2600],'O':[570,950,2600],
      'u:':[300,720,2400],'u':[320,750,2400],'U':[440,1020,2400],'y:':[280,1700,2150],'y':[290,1700,2150],'Y':[400,1500,2150],
      '2:':[400,1450,2250],'9':[520,1400,2300],'@':[500,1500,2500],'6':[650,1250,2500]};
    var DIPH={'aI':['a','I'],'aU':['a','U'],'OY':['O','Y']};
    var VOWT={'aI':1,'aU':1,'OY':1,'a:':1,'E:':1,'e:':1,'i:':1,'o:':1,'u:':1,'y:':1,'2:':1,'a':1,'E':1,'I':1,'O':1,'U':1,'Y':1,'9':1,'@':1,'6':1,'e':1,'i':1,'o':1,'u':1,'y':1};
    /* Konsonanten */
    var CON={
      p:{t:'stop',v:0,bt:'bandpass',bf:800,bq:0.7,bl:0.2,af:1500},
      t:{t:'stop',v:0,bt:'highpass',bf:4200,bq:0.7,bl:0.16,af:3500},
      k:{t:'stop',v:0,bt:'bandpass',bf:1900,bq:0.8,bl:0.2,af:2000},
      b:{t:'stop',v:1,vf:[200,800,2000],bt:'bandpass',bf:700,bq:0.7,bl:0.1},
      d:{t:'stop',v:1,vf:[200,1700,2600],bt:'highpass',bf:3500,bq:0.7,bl:0.07},
      g:{t:'stop',v:1,vf:[200,1500,2200],bt:'bandpass',bf:1700,bq:0.8,bl:0.1},
      f:{t:'fric',v:0,f:4200,q:0.5,lv:0.14},
      v:{t:'fric',v:1,vf:[300,900,2200],f:3500,q:0.6,lv:0.05},
      s:{t:'fric',v:0,f:7200,q:1.2,lv:0.26},
      z:{t:'fric',v:1,vf:[250,1200,2500],f:6500,q:1,lv:0.07},
      S:{t:'fric',v:0,f:3200,q:0.9,lv:0.3},
      C:{t:'fric',v:0,f:4300,q:1,lv:0.2},
      x:{t:'fric',v:0,f:2000,q:0.9,lv:0.2},
      h:{t:'fric',v:0,f:1700,q:0.5,lv:0.12},
      m:{t:'nas',vf:[250,1000,2200],lv:0.55},
      n:{t:'nas',vf:[250,1500,2500],lv:0.55},
      N:{t:'nas',vf:[250,1100,2300],lv:0.55},
      l:{t:'appr',vf:[360,1300,2900],lv:0.8},
      r:{t:'appr',vf:[450,1300,1900],lv:0.6,n:0.03},
      j:{t:'appr',vf:[280,2250,2900],lv:0.85},
      pf:{t:'aff',a:'p',b:'f'}, ts:{t:'aff',a:'t',b:'s'}, dZ:{t:'aff',a:'d',b:'S'}};
    var TOK=['aI','aU','OY','pf','ts','dZ','a:','E:','e:','i:','o:','u:','y:','2:','a','E','I','O','U','Y','9','@','6','e','i','o','u','y','p','t','k','b','d','g','f','v','s','z','S','x','C','h','m','n','N','l','r','j'];
    function tokenize(s){
      var out=[], i=0, k, m;
      while(i<s.length){
        m=null; for(k=0;k<TOK.length;k++){ if(s.substr(i,TOK[k].length)===TOK[k]){ m=TOK[k]; break; } }
        if(!m){ i++; continue; } out.push(m); i+=m.length;
      }
      return out;
    }
    function parseSyl(ph){
      var tk=tokenize(ph), vi=-1, i;
      for(i=0;i<tk.length;i++) if(VOWT[tk[i]]){ vi=i; break; }
      if(vi<0) return {on:tk,nuc:'@',co:[]};
      return {on:tk.slice(0,vi),nuc:tk[vi],co:tk.slice(vi+1)};
    }
    /* Aussprache-Wörterbuch (^ = betonte Silbe, . = Silbengrenze) */
    var DICT={
      'lass':'^las','die':'di:','affen':'^a.f@n','aus':'^aUs','dem':'dEm','zoo':'^tso:','hey':'^haI',
      'ich':'^IC','bin':'bIn','peter':'^pe:.t6','kleiner':'^klaI.n6','affe':'^a.f@','doch':'dOx','mein':'maIn','flow':'^flo:','ist':'Ist','riesengroß':'^ri:.z@n.^gro:s',
      'spring':'^SprIN','über':'^y:.b6','feuer':'^fOY.6','und':'Unt','reifen':'^raI.f@n','flieg':'^fli:k','vom':'fOm','boden':'^bo:.d@n','los':'^lo:s',
      'mit':'mIt','der':'d6','kappe':'^ka.p@','auf':'aUf','kopf':'^kOpf','kette':'^kE.t@','gold':'^gOlt',
      'jeder':'^je:.d6','boss':'^bOs','wird':'vIrt','besiegt':'b@.^zi:kt','weil':'vaIl','das':'das','so':'zo:','wollt':'^vOlt',
      'springen':'^SprI.N@n','ladeattacke':'^la:.d@.a.^ta.k@','goldene':'^gOl.d@.n@','banane':'ba.^na:.n@','in':'In','hand':'^hant',
      'schnellste':'^SnEl.st@','überhaupt':'y:.b6.^haUpt','bekannt':'b@.^kant','im':'Im','ganzen':'^gan.ts@n','land':'^lant',
      'schlange':'^SlaN.@','krokodil':'kro.ko.^di:l','spinne':'^SpI.n@','tiger':'^ti:.g6','hält':'^hElt','nicht':'nICt','stand':'^Stant',
      'papagei':'pa.pa.^gaI','nashorn':'^na:s.hOrn','fallen':'^fa.l@n','hab':'hap','sie':'zi:','schnell':'^SnEl','erkannt':'Er.^kant',
      'skorpion':'skOr.pi.^o:n','elefant':'e.le.^fant','schaffen':'^Sa.f@n','mich':'mIC','heut':'^hOYt','sammle':'^zam.l@','bananen':'ba.^na:.n@n',
      'hat':'hat','stets':'^Ste:ts','gefreut':'g@.^frOYt','feuerdrache':'^fOY.6.^dra.x@','speit':'^SpaIt','glut':'^glu:t','bleibe':'^blaI.b@',
      'cool':'^ku:l','zehn':'^tse:n','level':'^lE.v@l','ein':'aIn','gorilla':'go.^rI.la','den':'de:n','dschungelpool':'^dZUN.@l.^pu:l','dschungel':'^dZUN.@l',
      'riesig':'^ri:.zIC','keine':'^kaI.n@','angst':'^aNst','halte':'^hal.t@','taste':'^tas.t@','lade':'^la:.d@','bis':'bIs','du':'du:','staunst':'^StaUnst',
      'mega':'^me:.ga','schlag':'^Sla:k','bumm':'^bUm','knallt':'^knalt','ko':'ka:.^o:','hallt':'^halt'};
    /* Notlösung für unbekannte Wörter: einfache Lautumschrift */
    function g2p(w){
      var s=w.replace(/sch/g,'S').replace(/ch/g,'x').replace(/ck/g,'k').replace(/ei/g,'aI').replace(/ie/g,'i:').replace(/eu|äu/g,'OY').replace(/au/g,'aU').replace(/qu/g,'kv').replace(/ß/g,'s'), out='', i, c;
      var M={a:'a',e:'E',i:'I',o:'O',u:'U','ä':'E','ö':'9','ü':'Y',y:'Y',b:'b',c:'k',d:'d',f:'f',g:'g',h:'h',j:'j',k:'k',l:'l',m:'m',n:'n',p:'p',q:'k',r:'r',s:'z',t:'t',v:'f',w:'v',x:'ks',z:'ts'};
      for(i=0;i<s.length;i++){ c=s.charAt(i); if(c==='S'||c==='x'||c==='I'&&s.charAt(i+1)===':'||c===':'||c==='a'&&s.charAt(i+1)==='I'||c==='O'&&s.charAt(i+1)==='Y'||c==='a'&&s.charAt(i+1)==='U'){ out+=c; continue; } out+=(M[c]!==undefined?M[c]:''); }
      return out;
    }
    function wordSyls(w){
      var e=DICT[w], i, r=[];
      if(!e) return [{ph:g2p(w),stress:true}];
      e=e.split('.');
      for(i=0;i<e.length;i++){ var st=e[i].charAt(0)==='^'; r.push({ph:st?e[i].slice(1):e[i],stress:st}); }
      return r;
    }

    /* Rhythmus + Melodie planen: Silben auf das 16tel-Raster legen */
    var VS_ST=[5,8,5,3,8,10], VS_UN=[3,0,3,5,0,3];
    function planLine(text,span,tonic){
      var S=span*16, hook=text.indexOf(HOOKSTART)===0, raw=text.split(/[\s-]+/), syl=[], i, j;
      for(i=0;i<raw.length;i++){
        var w=raw[i], clean=w.toLowerCase().replace(/[.,!?'"]/g,''), bnd=/[,.!?]$/.test(w)?w.charAt(w.length-1):'';
        if(!clean) continue;
        var ss=wordSyls(clean);
        for(j=0;j<ss.length;j++){ var we=j===ss.length-1; syl.push({ph:ss[j].ph,stress:ss[j].stress,wordEnd:we,bnd:we?bnd:''}); }
      }
      var n=syl.length;
      if(hook||/^hey/i.test(text)){
        var steps, lens, degs, amp=1;
        if(hook){ steps=[0,2,4,6,8,10,12,14]; lens=[2,2,2,2,2,2,(n===7?4:2),2]; degs=[10,10,12,10,10,8,5,12]; }
        else { steps=[0,4,8]; lens=[3,3,6]; degs=[12,12,12]; amp=1.15; }
        for(i=0;i<n;i++){
          var sy=syl[i]; sy.step=steps[i]; sy.steps=lens[i]; sy.midi=tonic+degs[i]; sy.legato=0.93; sy.amp=amp*(sy.stress||!hook?1:0.9);
          sy.vib=(hook&&i===6&&n===7)||(!hook&&i===2);
        }
        return syl;
      }
      var wts=[], gaps=[], W=0, cum=0, pos, prev=-1;
      for(i=0;i<n;i++){
        var q=syl[i], nuc=parseSyl(q.ph).nuc, wg=q.stress?2:1;
        if(nuc==='@'||nuc==='6') wg=0.7;
        if(/:$/.test(nuc)) wg+=0.4;
        if(q.wordEnd&&q.bnd) wg+=0.8;
        var gp=(q.bnd&&i<n-1)?0.7:0;
        wts.push(wg); gaps.push(gp); W+=wg+gp;
      }
      for(i=0;i<n;i++){
        pos=cum*S/W; cum+=wts[i]+gaps[i];
        var st=syl[i].stress?Math.round(pos/2)*2:Math.round(pos);
        if(st<=prev) st=prev+1; syl[i].step=st; prev=st;
      }
      for(i=n-1;i>=0;i--){ var mx=S-(n-i); if(syl[i].step>mx) syl[i].step=mx; if(i<n-1&&syl[i].step>=syl[i+1].step) syl[i].step=syl[i+1].step-1; }
      var a=0, b=0, ph=0;
      for(i=0;i<n;i++){
        var z=syl[i], len=(i<n-1)?syl[i+1].step-z.step:Math.min(4,S-z.step);
        if(gaps[i]>0&&len>2) len-=1;
        z.steps=Math.max(1,len); z.legato=0.82;
        var deg;
        if(z.stress){ deg=VS_ST[a%6]; a++; } else { deg=VS_UN[b%6]; b++; }
        if(z.wordEnd&&z.bnd){ deg=(z.bnd==='!')?10:((ph%2)?0:3); ph++; }
        if(i===n-1) deg=0;
        z.midi=tonic+deg; z.amp=(i===0?1.05:1); z.vib=false;
      }
      return syl;
    }

    /* Stimm-Bausteine (einmal aufbauen, dann nur noch automatisieren) */
    function initVoice(){
      var N=40, re=new Float32Array(N+1), im=new Float32Array(N+1), k, i;
      for(k=1;k<=N;k++) im[k]=1/Math.pow(k,1.15);
      var wave=ac.createPeriodicWave(re,im);
      vo.a=ac.createOscillator(); vo.b=ac.createOscillator();
      vo.a.setPeriodicWave(wave); vo.b.setPeriodicWave(wave);
      vo.a.frequency.value=150; vo.b.frequency.value=150; vo.b.detune.value=7;
      vo.lfo=ac.createOscillator(); vo.lfo.frequency.value=5.4; vo.lfoG=ac.createGain(); vo.lfoG.gain.value=0;
      vo.lfo.connect(vo.lfoG); vo.lfoG.connect(vo.a.frequency); vo.lfoG.connect(vo.b.frequency);
      var mix=ac.createGain(); mix.gain.value=0.5; vo.a.connect(mix); vo.b.connect(mix);
      vo.amp=ac.createGain(); vo.amp.gain.value=0.0001; mix.connect(vo.amp);
      vo.sum=ac.createGain(); vo.sum.gain.value=1;
      vo.f=[]; var Q=[9,11,13], G=[1,0.55,0.3];
      for(i=0;i<3;i++){
        var bp=ac.createBiquadFilter(); bp.type='bandpass'; bp.Q.value=Q[i]; bp.frequency.value=500+i*1000;
        var g=ac.createGain(); g.gain.value=G[i];
        vo.amp.connect(bp); bp.connect(g); g.connect(vo.sum); vo.f.push(bp);
      }
      var lp=ac.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=450;
      var body=ac.createGain(); body.gain.value=0.25; vo.amp.connect(lp); lp.connect(body); body.connect(vo.sum);
      vo.nsrc=ac.createBufferSource(); vo.nsrc.buffer=noiseBuf; vo.nsrc.loop=true;
      vo.nf=ac.createBiquadFilter(); vo.nf.type='bandpass'; vo.nf.frequency.value=4000; vo.nf.Q.value=1;
      vo.ng=ac.createGain(); vo.ng.gain.value=0.0001;
      vo.nsrc.connect(vo.nf); vo.nf.connect(vo.ng); vo.ng.connect(vo.sum);
      var tone2=ac.createBiquadFilter(); tone2.type='lowpass'; tone2.frequency.value=7500; vo.sum.connect(tone2);
      vo.out=ac.createGain(); vo.out.gain.value=muted?0:VOUT*vs(); tone2.connect(vo.out); vo.out.connect(comp);
      var send=ac.createGain(); send.gain.value=0.18; tone2.connect(send); send.connect(echo);
      vo.a.start(); vo.b.start(); vo.lfo.start(); vo.nsrc.start();
    }
    function ps(p,v,at,tc){ if(!isFinite(v)||!isFinite(at)) return; p.setTargetAtTime(v,Math.max(at,ac.currentTime),tc||0.012); }
    function vForm(arr,at,tc){ for(var i=0;i<3;i++) ps(vo.f[i].frequency,arr[i],at,tc); }
    function vNoise(v,at,tc){ ps(vo.ng.gain,v,at,tc); }
    function vNoiseF(f,q,at){ ps(vo.nf.frequency,f,at,0.004); ps(vo.nf.Q,q,at,0.004); }
    function vAmp(v,at,tc){ ps(vo.amp.gain,v,at,tc); }
    function vBurst(at,type,f,q,v,d){
      var s=ac.createBufferSource(), fl=ac.createBiquadFilter(), g=ac.createGain();
      s.buffer=noiseBuf; fl.type=type; fl.frequency.value=f; fl.Q.value=q||1;
      env(g,at,0.002,v,d); s.connect(fl); fl.connect(g); g.connect(vo.sum); s.start(at); s.stop(at+d+0.05);
    }
    function cDur(tok,kf,coda){
      var c=CON[tok], d=c.t==='stop'?0.055:c.t==='aff'?0.1:c.t==='fric'?0.085:0.06;
      return d*kf*(coda?0.9:1);
    }
    function conSeg(tok,st,dur,lvl){
      var c=CON[tok];
      if(!c) return;
      if(c.t==='aff'){ conSeg(c.a,st,dur*0.45,lvl); conSeg(c.b,st+dur*0.45,dur*0.55,lvl); return; }
      if(c.t==='stop'){
        var bt=st+dur*0.62;
        if(c.v){ vForm(c.vf,st,0.008); vAmp(lvl*0.22,st,0.008); }
        else { vAmp(0.0001,st,0.004); vNoise(0.0001,st,0.004); }
        vBurst(bt,c.bt,c.bf,c.bq,c.bl,0.02);
        if(!c.v){ vNoiseF(c.af,0.6,bt); vNoise(0.1,bt,0.004); vNoise(0.0001,bt+dur*0.38,0.01); }
        return;
      }
      if(c.t==='fric'){
        if(c.v){ vForm(c.vf,st,0.01); vAmp(lvl*0.38,st,0.01); } else vAmp(0.0001,st,0.006);
        vNoiseF(c.f,c.q,st); vNoise(c.lv,st,0.01); vNoise(0.0001,st+dur,0.012);
        return;
      }
      vForm(c.vf,st,0.01); vAmp(lvl*c.lv,st,0.01); vNoise(c.n||0.0001,st,0.01);
    }
    /* Alle Silben einer Zeile als Parameter-Automation planen; liefert das Ende in Sekunden */
    function singSyllables(syls,at0,sp){
      var kf=Math.max(0.8,Math.min(1.25,sp/0.107)), P=[], i, k;
      for(i=0;i<syls.length;i++){
        var s=syls[i], pr=parseSyl(s.ph), o=0, c=0;
        for(k=0;k<pr.on.length;k++) o+=cDur(pr.on[k],kf,false);
        for(k=0;k<pr.co.length;k++) c+=cDur(pr.co[k],kf,true);
        P.push({s:s,pr:pr,on:o,co:c,g:at0+s.step*sp+(Math.random()-0.5)*0.006,D:s.steps*sp});
      }
      var prevEnd=at0-0.5;
      for(i=0;i<P.length;i++){
        var q=P[i], sy=q.s, pr2=q.pr, nxt=P[i+1];
        var vStart=q.g+0.012, oStart=Math.max(prevEnd,vStart-q.on), onScale=q.on>0?Math.min(1,(vStart-oStart)/q.on):1;
        var limit=(nxt?nxt.g+0.012-nxt.on*0.85:vStart+q.D)-vStart-q.co-0.008;
        var vDur=Math.max(0.07,Math.min(q.D*(sy.legato||0.84)-q.co,limit)), vEnd=vStart+vDur;
        var lvl=0.95*(sy.stress?1:0.78)*(sy.amp||1)*(0.95+Math.random()*0.1);
        var f=hz(sy.midi)*(1+(Math.random()-0.5)*0.008);
        ps(vo.a.frequency,f,vStart-0.045,0.028); ps(vo.b.frequency,f,vStart-0.045,0.028);
        if(sy.vib&&vDur>0.2){ ps(vo.lfoG.gain,f*0.011,vStart+0.12,0.08); ps(vo.lfoG.gain,0.0001,vEnd,0.03); }
        var t=oStart, dd;
        for(k=0;k<pr2.on.length;k++){ dd=cDur(pr2.on[k],kf,false)*onScale; conSeg(pr2.on[k],t,dd,lvl); t+=dd; }
        var nuc=pr2.nuc;
        if(DIPH[nuc]){ vForm(VOW[DIPH[nuc][0]],vStart,0.014); vForm(VOW[DIPH[nuc][1]],vStart+vDur*0.5,0.06); }
        else vForm(VOW[nuc]||VOW['@'],vStart,0.02);
        ps(vo.amp.gain,lvl,vStart,0.012); vNoise(0.0001,vStart,0.008);
        t=vEnd;
        for(k=0;k<pr2.co.length;k++){ dd=cDur(pr2.co[k],kf,true); conSeg(pr2.co[k],t,dd,lvl); t+=dd; }
        prevEnd=t;
        ps(vo.amp.gain,0.0001,t,0.012); vNoise(0.0001,t,0.012);
      }
      return prevEnd;
    }
    function voiceReset(){
      if(!ac||!vo.amp) return;
      var now=ac.currentTime, ps2=[vo.amp.gain,vo.a.frequency,vo.b.frequency,vo.ng.gain,vo.nf.frequency,vo.nf.Q,vo.lfoG.gain,vo.f[0].frequency,vo.f[1].frequency,vo.f[2].frequency], i;
      for(i=0;i<ps2.length;i++) ps2[i].cancelScheduledValues(now);
      vo.amp.gain.setTargetAtTime(0.0001,now,0.02); vo.ng.gain.setTargetAtTime(0.0001,now,0.02); vo.lfoG.gain.setTargetAtTime(0.0001,now,0.02);
      voiceEndMs=0;
    }

    /* ----- Alternative: Sprachausgabe des Browsers ----- */
    function scoreVoice(v){
      var n=(v.name||'')+' '+(v.voiceURI||''), s=0;
      if(/natural|neural|online|premium|enhanced|siri/i.test(n)) s+=4;
      if(/google/i.test(n)) s+=2;
      if(/markus|conrad|stefan|hans|jonas|florian|killian|viktor|martin|yannick|male|männlich/i.test(n)) s+=2;
      if(/compact|espeak|robot/i.test(n)) s-=4;
      if(/^de[-_]DE/i.test(v.lang)) s+=1;
      return s;
    }
    function pickVoice(){
      if(!canSpeak) return;
      var all=synth.getVoices()||[], i, k=-1;
      voices=all.filter(function(v){ return /^de/i.test(v.lang); }).sort(function(a,b){ return scoreVoice(b)-scoreVoice(a); });
      for(i=0;i<voices.length;i++) if(savedVoice&&voices[i].name===savedVoice) k=i;
      vIdx=k>=0?k:0; voice=voices[vIdx]||null;
      if(api&&api.onVoices) api.onVoices();
    }
    if(canSpeak){ pickVoice(); try{ synth.addEventListener('voiceschanged',pickVoice); }catch(e){} }
    function applyGain(){
      if(master) master.gain.setTargetAtTime(muted?0:(ducked?VOL*(vMode===0?0.72:0.4):VOL)*vs(),ac.currentTime,ducked?0.04:0.25);
      if(vo.out) vo.out.gain.setTargetAtTime(muted?0:VOUT*vs(),ac.currentTime,0.03);
    }
    function release(){
      if(Date.now()<voiceEndMs||(canSpeak&&(synth.speaking||synth.pending))){ duckTimer=setTimeout(release,300); return; }
      ducked=false; applyGain();
    }
    function duck(isOn){
      clearTimeout(duckTimer);
      if(isOn){ ducked=true; applyGain(); } else duckTimer=setTimeout(release,300);
    }
    function say(part,hook,rate,first){
      if(!canSpeak||vMode!==1||muted) return;
      try{
        if(first) synth.cancel();
        var u=new SpeechSynthesisUtterance(part); u.lang='de-DE'; if(voice) u.voice=voice;
        u.rate=rate; u.pitch=hook?0.8:0.88; u.volume=Math.max(0.05,Math.min(1,vs()));
        u.onstart=function(){ duck(true); }; u.onend=u.onerror=function(){ duck(false); };
        synth.speak(u);
      }catch(e){}
    }
    function schedLine(lines,idx,at,bar,tr){
      var text=lines[idx], span=1, i, tot=0, cum=0, hook=text.indexOf(HOOKSTART)===0;
      while(idx+span<lines.length&&lines[idx+span]==='') span++;
      /* Textzeile im Bild einblenden */
      setTimeout(function(){ if(!on) return; lineText=text; lineAt=Date.now(); lineHook=hook; },Math.max(0,(at-ac.currentTime)*1000));
      if(vMode===0&&vo.amp){
        var plan=planLine(text,span,52+tr), endT=singSyllables(plan,at,bar/16);
        voiceEndMs=Math.max(voiceEndMs,Date.now()+(endT-ac.currentTime)*1000);
        setTimeout(function(){ if(on) duck(true); },Math.max(0,(at-ac.currentTime)*1000));
        return;
      }
      if(vMode===1){
        var parts=text.match(/[^,.!?]+[,.!?]*/g)||[text];
        for(i=0;i<parts.length;i++){ parts[i]=parts[i].trim(); tot+=parts[i].length; }
        parts.forEach(function(pt,k){
          var share=pt.length/tot, startAt=at+span*bar*cum, slot=span*bar*share;
          cum+=share;
          var rate=Math.max(0.95,Math.min(hook?1.15:1.35,pt.length*0.068/(slot*0.9)));
          setTimeout(function(){ if(!on) return; say(pt,hook,rate,k===0); },Math.max(0,(startAt-ac.currentTime)*1000));
        });
      }
    }

    function tick(){
      var lvl=lvlNum(), isB=!!boss, song=isB?BOSS:RUN, key=(isB?'B':'R')+lvl;
      var sp=60/(song.bpm+BPMADD[(lvl-1)%10]+(lvl>10?5:0)+WBPM[world-1])/4, tr=TRANS[(lvl-1)%10]+(lvl>10?2:0)+WTR[world-1];
      var shift=(Math.min.apply(null,song.roots)+tr<29)?12:0;
      if(key!==lastKey){ lastKey=key; step=0; voiceReset(); if(canSpeak&&vMode===1){ try{ synth.cancel(); }catch(e){} } }
      while(nextT<ac.currentTime+0.12){
        var s=step%64, b=s%16, bar=s>>4, root=song.roots[bar]+tr+shift, t0=nextT, tt=t0+(b%2?sp*0.1:0);
        if(b===0){
          var li=Math.floor(step/16)%song.lines.length;
          if(bar===0||bar===2) pad(t0,root+12,sp*32*0.98);
          if(song.lines[li]) schedLine(song.lines,li,t0,sp*16,tr);
        }
        if(song.kick[bar].indexOf(b)>=0){ kick(t0,0.9); sub(t0,root,sp*3,0.75); }
        if(isB?(b===4||b===12):b===8) clap(t0,0.5);
        if(isB||b%2===0) hat(tt,(b%4===0)?0.07:0.035,0.03);
        if(!isB&&bar%2===1&&b>=12&&b%2===1) hat(tt,0.03,0.02);
        if(isB&&b>=12) hat(tt+sp/2,0.03,0.02);
        if(isB&&(b===0||b===3||b===6||b===10)) stab(t0,root+24,0.13,sp*1.5);
        if(song.mel[s]) pluck(song.mel[s]+tr,tt,isB?0.2:0.17);
        nextT+=sp; step++;
      }
    }
    function start(){
      var AC=window.AudioContext||window.webkitAudioContext; if(!AC) return;
      paused=false;
      if(!ac){
        ac=new AC(); master=ac.createGain(); master.gain.value=muted?0:VOL*vs();
        comp=ac.createDynamicsCompressor(); comp.threshold.value=-16; comp.knee.value=24; comp.ratio.value=4; comp.attack.value=0.01; comp.release.value=0.2;
        master.connect(comp); comp.connect(ac.destination);
        echo=ac.createGain(); echo.gain.value=0.5;
        var dl=ac.createDelay(1), fb=ac.createGain(), lp=ac.createBiquadFilter(), wet=ac.createGain();
        dl.delayTime.value=0.27; fb.gain.value=0.3; lp.type='lowpass'; lp.frequency.value=2200; wet.gain.value=0.5;
        echo.connect(dl); dl.connect(lp); lp.connect(fb); fb.connect(dl); lp.connect(wet); wet.connect(master);
        noiseBuf=ac.createBuffer(1,ac.sampleRate*0.5,ac.sampleRate);
        var d=noiseBuf.getChannelData(0); for(var i=0;i<d.length;i++) d[i]=Math.random()*2-1;
        initVoice();
      }
      if(ac.state!=='running') ac.resume();
      if(!on){ on=true; lastKey=null; nextT=ac.currentTime+0.05; timer=setInterval(tick,25); }
    }
    function stop(){
      on=false; clearInterval(timer); voiceReset(); if(ac) ac.suspend();
      if(canSpeak){ try{ synth.cancel(); }catch(e){} }
      ducked=false;
    }
    function pause(){ if(on){ paused=true; stop(); } }
    function resume(){ if(paused) start(); }
    function toggle(){
      muted=!muted; try{localStorage.setItem('peterMute',muted?'1':'0')}catch(e){}
      applyGain();
      if(muted){ voiceReset(); if(canSpeak){ try{ synth.cancel(); }catch(e){} } }
    }
    /* Stimme: 0 = Gesang (eigener Synthesizer), 1 = Sprachausgabe des Browsers, 2 = aus */
    function voiceCycle(){
      vMode=(vMode+1)%3; if(vMode===1&&!canSpeak) vMode=2;
      try{localStorage.setItem('peterVoiceMode',vMode)}catch(e){}
      voiceReset(); ducked=false; applyGain();
      if(canSpeak){ try{ synth.cancel(); }catch(e){} }
    }
    function cycleVoice(){
      if(voices.length<2||vMode!==1) return;
      vIdx=(vIdx+1)%voices.length; voice=voices[vIdx];
      try{localStorage.setItem('peterVoiceName',voice.name)}catch(e){}
      if(!muted) say('Lass die Affen aus dem Zoo!',true,1,true);
    }
    function line(){
      if(muted||!lineText) return null;
      var age=(Date.now()-lineAt)/1000; if(age>3.6) return null;
      return {text:lineText,hook:lineHook,age:age};
    }
    function setVol(v){ vol=Math.max(0,Math.min(1,v)); try{localStorage.setItem('peterVol',vol)}catch(e){} if(ac) applyGain(); }
    api={start:start, stop:stop, pause:pause, resume:resume, toggle:toggle, voiceCycle:voiceCycle, cycleVoice:cycleVoice,
      muted:function(){ return muted; }, voiceMode:function(){ return vMode; }, voiceOn:function(){ return vMode!==2; }, canSpeak:function(){ return canSpeak; }, canSing:function(){ return canSing; },
      voiceCount:function(){ return voices.length; }, voiceIdx:function(){ return vIdx; },
      setVol:setVol, getVol:function(){ return vol; },
      line:line, rapping:function(){ var l=line(); return !!l&&l.age<3.2&&vMode!==2; }, onVoices:null,
      _plan:function(text,span,tonic){ return planLine(text,span,tonic); }};
    return api;
  })();
  function toggleMusic(){ music.start(); music.toggle(); }
  function toggleVoice(){ music.voiceCycle(); }
  function nextVoice(){ music.cycleVoice(); }


  function fmt(n){ return Math.round(n).toLocaleString('de-DE'); }
  function lvlNum(){ var n=Math.round(nextBoss/STEP); if(state==='rescue'&&rescue&&rescue.lvl) n=rescue.lvl; return Math.max(1,Math.min(NLV,n)); }
  function lvDef(n){ return LEVELS[(n-1)%CYC]; }
  function curLv(){ return lvDef(lvlNum()); }
  function lvName(n){ return lvDef(n).name+(n>CYC?' II':''); }
  function chargeLvl(){ return Math.min(1,chargeT*(power>0?2:1)/CH); }

  function resize(){
    var dpr=window.devicePixelRatio||1, iw=window.innerWidth, ih=window.innerHeight;
    scale=Math.min(ih/400, iw/640);
    W=iw/scale; Hw=ih/scale; GROUND=Hw-Math.max(70,Hw*0.2);
    cv.width=Math.round(iw*dpr); cv.height=Math.round(ih*dpr);
    ctx.setTransform(dpr*scale,0,0,dpr*scale,0,0);
    if(p.on) p.y=GROUND;
  }
  function reset(){
    p={y:GROUND,vy:0,on:true,j:0}; px=X; obs=[]; bans=[]; hearts=[]; pows=[]; parts=[]; pops=[]; dist=0; speed=300; pts=0; score=0;
    toNext=W*0.7; buffer=0; boss=null; nextBoss=STEP; pending=false; shootCd=0; shootAnim=0; rescue=null;
    charging=false; chargeT=0; power=0; powPx=diff.powPx*0.6; powT=3; lvlBanner=0; hintT=0; shake=0; giantT=0; gs=1; pCount=0; giantLeft=3; runBan=0; runT=0; slideV=0; slideX=0; combo=0; comboT=0; bonus=0; lastMult=1; giantUsed=0; danceT=0; trail=[]; spCd=2; spShieldT=0; slowT=0; spFlash=0;
    clouds=[]; for(var i=0;i<5;i++) clouds.push({x:Math.random()*W,y:30+Math.random()*110,s:0.7+Math.random()*0.8});
  }
  function startGame(i){ sel=i; di=i; diff=DIFFS[i]; reset(); addStat('runs',1); state='play'; lvlBanner=3; hintT=6.5; }
  function toMenu(){ toMain(); }
  function JVm(){ return JV*(1+0.05*PU.j)*wxv('jv',1); }
  var BDM=0.1; /* Bananenschaden: 10 % der früheren Stärke */
  function DM(){ return 1+0.25*PU.d; }
  function jump(){
    if(p.on){ p.vy=-JVm(); p.on=false; p.j=1; buffer=0; }
    else if(p.j<maxJ()){
      p.vy=-JVm()*0.92; p.j++; buffer=0;
      burst(px,p.y-4,12,['#ffffff','#cfeaff','#8fd3ff'],170);
      pop(px,p.y-70,world===6?'Paddeln!':'Doppelsprung!','#fff',16,0.6);
    }
    else buffer=0.12;
  }

  /* ===== Partikel & Texte ===== */
  function burst(x,y,n,cols,sp){
    for(var i=0;i<n&&parts.length<320;i++){
      var a=Math.random()*6.283, v=(sp||200)*(0.3+Math.random());
      parts.push({x:x,y:y,vx:Math.cos(a)*v,vy:Math.sin(a)*v-60,life:0.45+Math.random()*0.45,s:2+Math.random()*4,col:cols[i%cols.length]});
    }
  }
  function pop(x,y,s,col,size,life){ pops.push({x:x,y:y,txt:s,col:col||'#fff',size:size||20,life:life||0.9,max:life||0.9}); }

  /* ===== Schießen: Tippen = Banane, Halten im Bosskampf = Ladeangriff ===== */
  function shoot(){
    if(state!=='play'||shootCd>0) return;
    var pw=power>0;
    bans.push({x:px+26*gs,y:p.y-38*gs,dmg:Math.max(1,Math.round((pw?20:10)*DM()*BDM)),r:10,vx:pw?860:720,gold:pw});
    shootCd=pw?0.18:0.32; shootAnim=0.15;
  }
  function fireCharged(c){
    var pw=power>0, dmg=Math.max(1,Math.round((30+70*c)*(pw?1.5:1)*(2/3)*DM()*BDM));
    bans.push({x:px+26*gs,y:p.y-38*gs,dmg:dmg,r:14+14*c,vx:900,big:true,c:c,gold:true});
    shootCd=0.5; shootAnim=0.3; shake=Math.max(shake,0.08+0.12*c);
    burst(px+30,p.y-38,10+Math.round(14*c),['#fff07a','#ffd23f','#ff9a2e'],240);
  }
  function aDown(){
    if(state!=='play') return;
    if(boss&&boss.phase!=='dying'){ charging=true; chargeT=0; }
    else shoot();
  }
  function aUp(){
    if(!charging) return;
    charging=false; var c=chargeT; chargeT=0;
    if(state!=='play') return;
    if(c<TAP) shoot(); else fireCharged(Math.min(1,c*(power>0?2:1)/CH));
  }
  function press(){
    if(isMenuState()||state==='pause'){ var itp=uiItems(); if(itp[sel]) uiActivate(itp[sel].id,null); }
    else if(state==='dead'||state==='win'){ if(t-endAt>0.6) startGame(di); }
    else if(state==='play') jump();
  }
  function saveBest(){ if(score>bests[di]){ bests[di]=score; try{localStorage.setItem(bestKey(di),bests[di])}catch(e){} } }
  function die(){ almost=calcAlmost(); saveMis(); state='dead'; endAt=t; charging=false; chargeT=0; saveBest(); }

  /* ===== Power-Bananen ===== */
  function spawnPow(){ pows.push({x:W+30,h:45+Math.random()*95,ph:Math.random()*6}); }
  function collectPow(pw){
    power=Math.min(14,power+8); addStat('pow',1);
    pop(px,p.y-96,'POWER!','#ffd23f',26,1.1);
    var gain=PU.v?2:1; bananas+=gain; runBan+=gain; saveEco(); pop(px+34,p.y-62,'+'+gain,'#fff07a',18,0.8);
    burst(pw.x,GROUND-pw.h,18,['#fff07a','#ffd23f','#ffffff'],260);
    if(giantLeft>0&&pCount<5){
      pCount++;
      if(pCount>=5){ pop(px,p.y-150,'Riesen-Peter bereit!','#ffd23f',26,1.6); burst(px,p.y-40,24,['#fff07a','#ffd23f','#ffffff'],300); }
    }
  }
  function specLv(){ return PU.s[costume]|0; }
  function specCdMax(){ return 10-1.5*(specLv()-1); }
  function specAvail(){ return state==='play'&&specLv()>0; }
  function specRect(){ return {x:12,y:Hw-48,w:124,h:36}; }
  function dmgBoss(d,x,y){
    var b=boss; if(!b||b.phase!=='fight') return;
    b.hp-=d; b.flash=0.2; pop(x==null?b.x:x,y==null?GROUND-b.hh*0.7:y,'-'+d,'#8fd3ff',22,0.8);
    if(b.hp<=0){ b.hp=0; b.phase='dying'; b.dead=0; obs=[]; shake=0.6; burst(b.x,GROUND-b.hh*0.5,40,['#ffd23f','#ff6b2c','#ffffff','#e03a3a'],380); bossKilled(false); }
  }
  function fireSpecial(){
    if(!specAvail()||spCd>0) return;
    var L=specLv(), sx=px+26*gs, sy=p.y-38*gs, i, n;
    spCd=specCdMax(); shootAnim=0.25; addStat('spec',1);
    pop(px,p.y-120,SPEC[costume].n+'!','#8fd3ff',22,1.1);
    switch(costume){
      case 0: n=1+2*L; for(i=0;i<n;i++) bans.push({x:sx,y:sy,dmg:Math.round(12*DM()),r:9,vx:760,vy:(i-(n-1)/2)*70,gold:true}); break;
      case 1: bans.push({sk:'wave',x:sx,y:sy,dmg:[40,65,95][L-1],r:46,vx:620,clr:true,pierce:true}); shake=Math.max(shake,0.15); break;
      case 2: bans.push({sk:'laser',x:sx,y:sy,dmg:[45,75,110][L-1],r:8,vx:2200,clr:true,pierce:true,len:220}); shake=Math.max(shake,0.12); break;
      case 3: slowT=[3,4.5,6][L-1]; spFlash=0.25; break;
      case 4: bans.push({sk:'ball',x:sx,y:sy,dmg:[60,95,140][L-1],r:18,vx:640,clr:true}); shake=Math.max(shake,0.2); break;
      case 5: n=1+2*L; for(i=0;i<n;i++) bans.push({sk:'star',x:sx,y:sy,dmg:[20,26,32][L-1],r:10,vx:820,vy:(i-(n-1)/2)*45,pierce:true}); break;
      case 6: spShieldT=[5,8,12][L-1]; spFlash=0.15; break;
      case 7: obs=[]; spFlash=0.35; shake=Math.max(shake,0.3); dmgBoss([40,70,110][L-1]); burst(W/2,Hw/2,30,['#8fd3ff','#ffffff','#4a7de0'],420); break;
    }
  }
  function giantReady(){ return state==='play'&&giantLeft>0&&pCount>=5&&giantT<=0; }
  function giantRect(){ return {x:W-162,y:Hw-48,w:150,h:36}; }
  function activateGiant(){
    if(!giantReady()) return;
    giantT=7; giantLeft--; pCount=0; giantUsed=1; addStat('giant',1);
    pop(px,p.y-150,'RIESEN-PETER!','#ffd23f',30,1.5); shake=Math.max(shake,0.35);
    burst(px,p.y-40,34,['#fff07a','#ffd23f','#ff9a2e','#ffffff'],360);
  }

  /* ===== Bosse ===== */
  function startBoss(){
    var n=lvlNum(), L=lvDef(n), wut=n>CYC, hp=Math.max(40,Math.round(L.hp*diff.hp*(wut?1.5:1)/10)*10);
    boss={n:n,L:L,max:hp,hp:hp,shown:1,hw:L.hw,hh:L.hh,x:W+L.hw+120,phase:'in',timer:1,flash:0,throwT:0,dead:0,age:0,ph:0,sw:L.swing,q:0,rage:wut,wut:wut,final:L.boss==='gorilla'};
    powT=2.5; giantT=0; if(wut) shake=Math.max(shake,0.25);
  }
  function endBoss(){
    var fin=boss.final, bn=boss.n; boss=null; pending=false; nextBoss+=STEP; toNext=W*0.6; bans=[]; charging=false; chargeT=0;
    if(fin){ pows=[]; rescue={phase:'walk',wx:W-60,t:0,open:0,abduct:bn<NLV,gx:W+120,lift:0,lvl:bn}; state='rescue'; }
    else { lvlBanner=3; pows.push({x:W+40,h:70,ph:0}); }
  }
  function attackOne(b){
    var L=b.L, fly=Math.random()<Math.min(0.7,L.fly*diff.fly), v=L.sp*diff.proj*(b.rage?1.12:1)*(b.wut?1.08:1);
    if(fly) obs.push({k:'proj',sp:L.flyS,fy:Math.random()<0.5?44:96,r:16,w:32,h:32,x:b.x-50,vx:-(v+30)});
    else obs.push({k:'proj',sp:L.roll,w:L.rw,h:L.rw,x:b.x-40,vx:-v});
    b.throwT=0.35;
  }
  function updateBoss(dt){
    var b=boss, tx=W-190, L=b.L;
    b.age+=dt; if(b.flash>0) b.flash-=dt; if(b.throwT>0) b.throwT-=dt;
    b.shown+=((b.hp/b.max)-b.shown)*Math.min(1,dt*8);
    if(b.phase==='in'){ b.x-=300*dt; if(b.x<=tx){ b.x=tx; b.phase='fight'; b.timer=1; } }
    else if(b.phase==='fight'){
      b.ft=(b.ft||0)+dt;
      if(!b.rage&&b.hp<=b.max*0.35){ b.rage=true; pop(b.x,GROUND-b.hh-10,'WUT!','#ff5a3a',28,1.4); shake=Math.max(shake,0.3); }
      var swT=L.swing*(b.rage?1.2:1); b.sw+=(swT-b.sw)*Math.min(1,dt*3);
      b.ph+=dt*L.mv*(b.rage?1.3:1);
      b.x=tx+Math.sin(b.ph)*b.sw;
      b.timer-=dt;
      if(b.timer<=0){
        attackOne(b);
        b.timer=Math.max(0.6,L.rate*diff.atk*(b.rage?0.8:1)*(b.wut?0.88:1))+Math.random()*0.6*diff.atk;
        if(Math.random()<Math.min(0.75,L.dbl*diff.dbl+(b.rage?0.15:0)+(b.wut?0.15:0))){ b.q=0.3; b.timer+=0.3; }
      }
      if(b.q>0){ b.q-=dt; if(b.q<=0) attackOne(b); }
      for(var i=bans.length-1;i>=0;i--){
        var bn=bans[i], hgt=GROUND-bn.y;
        if(bn.big||bn.clr){
          for(var q=obs.length-1;q>=0;q--){
            var o=obs[q]; if(o.k!=='proj') continue;
            var bb=box(o);
            if(bn.x+bn.r>bb[0]&&bn.x-bn.r<bb[1]&&bn.y+bn.r>bb[2]&&bn.y-bn.r<bb[3]){
              burst((bb[0]+bb[1])/2,(bb[2]+bb[3])/2,10,['#ffd23f','#ffffff','#ff9a2e'],220); obs.splice(q,1);
            }
          }
        }
        if(bn.x+bn.r>b.x-b.hw && bn.x-bn.r<b.x+b.hw && hgt>-bn.r && hgt<b.hh+bn.r){
          if(bn.pierce){ if(bn.hit) continue; bn.hit=true; } else bans.splice(i,1);
          b.hp-=bn.dmg; b.flash=0.2; addStat('hit',1); if(bn.big) comboAct(1,10);
          pop(b.x+(Math.random()*40-20),GROUND-b.hh*0.7,'-'+bn.dmg,bn.big?'#ffd23f':'#fff',bn.big?28:18,0.8);
          burst(bn.x,bn.y,bn.big?22:8,['#ffd23f','#fff07a','#ffffff'],bn.big?300:180);
          if(bn.big) shake=Math.max(shake,0.25);
          if(b.hp<=0){ b.hp=0; b.phase='dying'; b.dead=0; obs=[]; shake=0.6; burst(b.x,GROUND-b.hh*0.5,40,['#ffd23f','#ff6b2c','#ffffff','#e03a3a'],380); bossKilled(!!bn.big); break; }
        }
      }
    } else if(b.phase==='dying'){ b.dead+=dt; if(b.dead>1.4) endBoss(); }
  }
  function updateRescue(dt){
    var r=rescue; r.t+=dt; dist+=60*dt;
    r.open=Math.min(1,r.open+dt);
    if(!p.on){ p.y+=p.vy*dt; p.vy+=G*wxv('g',1)*dt; if(p.y>=GROUND){ p.y=GROUND; p.vy=0; p.on=true; p.j=0; } }
    if(r.phase==='walk'){
      if(p.on) px+=220*dt;
      if(px>=r.wx-48){ px=r.wx-48; r.phase='kiss'; r.t=0; }
    } else if(r.phase==='kiss'){
      if(Math.random()<dt*10) hearts.push({x:r.wx-24+Math.random()*20-10,y:p.y-95,v:40+Math.random()*40,life:1.6,s:9+Math.random()*9});
      if(r.t>3.5){
        if(r.abduct){ r.phase='grab'; r.t=0; r.gx=W+110; }
        else {
          pts=FINAL; score=FINAL+bonus; saveBest(); worldDone(world,di);
          if(world<WORLDS.length){ r.phase='nextworld'; r.t=0; }
          else { state='win'; endAt=t; }
        }
      }
    } else if(r.phase==='grab'){
      r.gx-=300*dt;
      if(r.gx<=r.wx+62){ r.gx=r.wx+62; r.phase='seize'; r.t=0; shake=Math.max(shake,0.3); if(p.on){ p.vy=-JV*0.8; p.on=false; } }
    } else if(r.phase==='seize'){
      r.lift=90*Math.min(1,r.t/0.9);
      if(r.t>1.1){ r.phase='carry'; r.t=0; }
    } else if(r.phase==='carry'){
      r.gx+=280*dt; r.wx=r.gx-62; r.lift=90;
      if(r.gx>W+140){ r.phase='gone'; r.t=0; }
    } else if(r.phase==='nextworld'){
      /* Welt geschafft: direkt weiter in die nächste Welt */
      if(r.t>3.6){
        var keepBan=runBan, keepSpec=spCd;
        setWorld(world+1); reset(); runBan=keepBan; spCd=Math.min(keepSpec,2);
        state='play'; lvlBanner=4; worldBanner=4; hintT=0;
      }
    } else if(r.phase==='gone'){
      if(r.t>3.4){
        rescue=null; state='play'; px=X; p.y=GROUND; p.vy=0; p.on=true; p.j=0;
        lvlBanner=3.5; toNext=W*0.7; hearts=[]; pows.push({x:W+40,h:70,ph:0});
      }
    }
  }
  function box(o){
    if(o.k==='gap') return [o.x+14,o.x+o.w-14,GROUND-6,GROUND+30];
    if(o.fy!==undefined) return [o.x+4,o.x+o.w-4,GROUND-o.fy-o.r+4,GROUND-o.fy+o.r-4];
    return [o.x+7,o.x+o.w-7,GROUND-o.h+10,GROUND];
  }

  function update(dt){
    if(shootCd>0) shootCd-=dt; if(shootAnim>0) shootAnim-=dt; if(shake>0) shake-=dt; if(menuMsgT>0) menuMsgT-=dt;
    for(var h=hearts.length-1;h>=0;h--){ hearts[h].y-=hearts[h].v*dt; hearts[h].life-=dt; if(hearts[h].life<=0) hearts.splice(h,1); }
    for(var a=parts.length-1;a>=0;a--){ var pq=parts[a]; pq.x+=pq.vx*dt; pq.y+=pq.vy*dt; pq.vy+=520*dt; pq.life-=dt; if(pq.life<=0) parts.splice(a,1); }
    for(var c=pops.length-1;c>=0;c--){ var pp=pops[c]; pp.y-=46*dt; pp.life-=dt; if(pp.life<=0) pops.splice(c,1); }
    for(var tq=trail.length-1;tq>=0;tq--){ var tr=trail[tq]; tr.x-=(state==='rescue'?60:speed)*dt*0.9; tr.life-=dt; if(tr.life<=0) trail.splice(tq,1); }
    if(trailSel>0&&(state==='play'||state==='rescue')&&trail.length<90) trail.push({x:px-12*gs,y:p.y-(trailSel===2?26:10+Math.random()*30)*gs,life:0.55,r:Math.random()*6});
    if(misDirty&&(misSaveT+=dt)>3){ misSaveT=0; saveMis(); }
    if(state==='rescue'){ updateRescue(dt); return; }
    if(state!=='play') return;
    runT+=dt;
    if(lvlBanner>0) lvlBanner-=dt; if(worldBanner>0) worldBanner-=dt; if(hintT>0) hintT-=dt; if(power>0) power=Math.max(0,power-dt);
    if(spCd>0) spCd-=dt; if(spShieldT>0) spShieldT-=dt; if(slowT>0) slowT-=dt; if(spFlash>0) spFlash-=dt;
    if(giantT>0) giantT=Math.max(0,giantT-dt);
    if(danceT>0) danceT-=dt;
    gs+=((giantT>0?1.9:1)-gs)*Math.min(1,dt*7);
    var fighting=!!boss;
    if(charging){ if(!boss||boss.phase==='dying'){ charging=false; chargeT=0; } else chargeT+=dt; }
    speed=fighting?260:Math.min(Math.min(860,780*diff.spd),(330+pts*0.048)*diff.spd);
    if(slowT>0) speed*=0.5;
    dist+=speed*dt;
    if(!fighting&&!pending){ pts+=speed*dt/10; if(pts>=nextBoss){ pts=nextBoss; pending=true; } }
    score=Math.floor(pts)+bonus; maxStat('pts',score);
    if(combo>0&&obs.length>0){ comboT-=dt; if(comboT<=0){ if(combo>=5) pop(px,p.y-100,'Combo vorbei','#fff',14,0.8); combo=0; lastMult=1; } }
    if(buffer>0){ buffer-=dt; if(p.on){ p.vy=-JVm(); p.on=false; p.j=1; buffer=0; } }
    if(!p.on){ p.y+=p.vy*dt; p.vy+=G*wxv('g',1)*dt; if(p.y>=GROUND){ p.y=GROUND; p.vy=0; p.on=true; p.j=0; if(wxv('slide',0)) slideV=230; } }
    if(wxv('slide',0)){
      slideX+=slideV*dt; slideV=Math.max(0,slideV-520*dt); if(slideV<=0) slideX=Math.max(0,slideX-40*dt); px=X+slideX;
      if(slideV>40&&p.on&&Math.random()<dt*40) parts.push({x:px-8,y:GROUND-2,vx:-80-Math.random()*60,vy:-50-Math.random()*80,life:0.4,s:2.5,col:'#ffffff'});
    }
    if(!fighting&&!pending){
      toNext-=speed*dt;
      if(toNext<=0){
        var r=Math.random(), eff=pts*diff.ramp, o, wx=WX[world], spc=wx&&wx.sp;
        if(spc&&eff>=250&&Math.random()<spc.p) o=mkSpecial(spc);
        else if(r<0.26) o={k:'flame',w:34,h:56};
        else if(r<0.46) o={k:'flames',w:78,h:56};
        else if(r<0.62&&eff>=1600) o={k:'big',w:40,h:80};
        else if(r<0.76&&eff>=3000) o={k:'triple',w:118,h:56};
        else if(r<0.88&&eff>=2000) o={k:'tires',w:100,h:52};
        else o={k:'tire',w:52,h:52};
        if(wx&&o.k!=='drop'&&o.k!=='gap'&&o.k!=='tramp'&&o.k!=='proj'){
          if(wx.mirage&&Math.random()<0.28) o.fake=1;
          if(wx.cars&&o.k==='tire') o.vx=-(speed+170);
          if(wx.hoop&&(o.k==='flame'||o.k==='big')) o.hoop=1;
        }
        o.x=W+30; obs.push(o);
        if(o.k==='tramp'){ obs.push({k:'big',w:40,h:80,x:W+30+o.w+150}); toNext=o.w+190+speed*diff.gap+150+Math.random()*120; }
        else toNext=(o.w+speed*diff.gap+110+Math.random()*200)*wxv('space',1);
      }
    }
    /* Power-Bananen erscheinen */
    if(!fighting&&!pending){ powPx-=speed*dt; if(powPx<=0){ spawnPow(); powPx=diff.powPx*(0.8+Math.random()*0.5); } }
    else if(boss&&boss.phase==='fight'){ powT-=dt; if(powT<=0){ spawnPow(); powT=diff.powFight+Math.random()*3; } }
    for(var m=pows.length-1;m>=0;m--){
      var pw=pows[m]; pw.x-=speed*dt; var py=GROUND-pw.h;
      if(Math.abs(px-pw.x)<30*gs&&py>p.y-86*gs&&py<p.y+16){ collectPow(pw); pows.splice(m,1); continue; }
      if(pw.x<-40) pows.splice(m,1);
    }
    for(var i=obs.length-1;i>=0;i--){ var ob=obs[i]; if(ob.vx) ob.x+=ob.vx*dt*(slowT>0?0.5:1); else ob.x-=speed*dt; if(ob.x<-120) obs.splice(i,1); }
    for(var q3=obs.length-1;q3>=0;q3--){ var od=obs[q3];
      if(od.k==='drop'){
        if(!od.fall&&od.x-px<speed*1.0) od.fall=1;
        if(od.fall&&od.fy>od.r){ od.vf+=1500*dt; od.fy=Math.max(od.r,od.fy-od.vf*dt);
          if(od.fy<=od.r){ shake=Math.max(shake,0.12); burst(od.x+od.r,GROUND-4,8,od.sp==='icicle'?['#ffffff','#bfe4ff']:['#ff9a2e','#ffd23f','#7a6a5a'],160); } }
      } else if(od.bob!==undefined) od.fy=od.fy0+Math.sin(t*2.4+od.bob)*22;
      else if(od.k==='tramp'){
        if(od.sq>0) od.sq-=dt;
        if(p.on&&px+10>od.x&&px-10<od.x+od.w){ p.vy=-JVm()*1.4; p.on=false; p.j=1; buffer=0; od.sq=0.3; pop(px,p.y-70,'Boing!','#7ad84a',20,0.7); comboAct(1,10); }
      }
    }
    clouds.forEach(function(cl){ cl.x-=speed*0.08*cl.s*dt; if(cl.x<-80) cl.x=W+60; });
    for(var j=bans.length-1;j>=0;j--){
      var bn=bans[j]; bn.x+=bn.vx*dt; if(bn.vy) bn.y+=bn.vy*dt;
      if(bn.clr){
        for(var q2=obs.length-1;q2>=0;q2--){ var bb2=box(obs[q2]); if(bn.x+bn.r>bb2[0]&&bn.x-bn.r<bb2[1]&&bn.y+bn.r>bb2[2]&&bn.y-bn.r<bb2[3]){ burst((bb2[0]+bb2[1])/2,(bb2[2]+bb2[3])/2,10,['#8fd3ff','#ffffff','#ffd23f'],220); obs.splice(q2,1); } }
      }
      if(bn.big&&parts.length<320&&Math.random()<dt*50) parts.push({x:bn.x-10,y:bn.y+(Math.random()*16-8)*(1+bn.c),vx:-80,vy:Math.random()*60-30,life:0.35,s:3+3*bn.c,col:'#ffd23f'});
      if(bn.x>W+40) bans.splice(j,1);
    }
    if(pending&&!boss){
      var clear=true; obs.forEach(function(q){ if(q.x+q.w>px-30) clear=false; });
      if(clear) startBoss();
    }
    if(boss) updateBoss(dt);
    var gk=giantT>0?gs:1, pl=px-14*gk, pr=px+14*gk, pt=p.y-48*gk, pb=p.y-4;
    for(var k=obs.length-1;k>=0;k--){
      var bx=box(obs[k]), ob2=obs[k];
      if(ob2.fake||ob2.safe) continue;
      if(pr>bx[0]&&pl<bx[1]){ var gap=Math.max(bx[2]-pb,pt-bx[3]); if(ob2.mg===undefined||gap<ob2.mg) ob2.mg=gap; }
      if(!ob2.passed&&ob2.mg!==undefined&&bx[1]<pl){
        ob2.passed=1;
        if(ob2.mg<16){ addStat('near',1); comboAct(2,15); pop(px,p.y-80*gs,'Knapp!','#8fd3ff',16,0.6); }
        else comboAct(1,5);
        if(ob2.hoop&&!p.on){ comboAct(1,20); pop(px,p.y-104,'Durch den Reifen!','#ffd23f',16,0.8); }
      }
      if(pr>bx[0] && pl<bx[1] && pb>bx[2] && pt<bx[3]){
        if(giantT>0){ burst((bx[0]+bx[1])/2,(bx[2]+bx[3])/2,16,['#ffd23f','#ff9a2e','#ffffff','#e03a3a'],300); obs.splice(k,1); shake=Math.max(shake,0.15); }
        else if(spShieldT>0){ spShieldT=0; burst((bx[0]+bx[1])/2,(bx[2]+bx[3])/2,16,['#8fd3ff','#ffffff','#4a7de0'],300); obs.splice(k,1); shake=Math.max(shake,0.15); pop(px,p.y-110,'Schild!','#8fd3ff',22,0.8); }
        else { die(); break; }
      }
    }
  }

  function saveEco(){ try{ localStorage.setItem('peterBananas',bananas); localStorage.setItem('peterOwned2',JSON.stringify(owned)); localStorage.setItem('peterPlat',JSON.stringify(plat)); localStorage.setItem('peterPlatOn',JSON.stringify(platOn)); localStorage.setItem('peterPU',JSON.stringify(PU)); }catch(e){} }
  function setCostume(n){ n=((n%8)+8)%8; if(!owned[n]) return; costume=n; try{localStorage.setItem('peterCostume2',costume)}catch(e){} }
  function cycleCos(d){ var n=costume, i; for(i=0;i<8;i++){ n=(n+d+8)%8; if(owned[n]){ setCostume(n); return; } } }
  /* Kostüme für Peter: 0 Rapper, 1 Superheld, 2 Astronaut */
  function drawBack(){
    var x=px, y=p.y, air=!p.on, fl=Math.sin(t*14)*4;
    if(costume===2){
      var len=air?54:40;
      ctx.fillStyle='#d62c2c'; ctx.strokeStyle='#8a1a1a'; ctx.lineWidth=2; ctx.beginPath();
      ctx.moveTo(x-4,y-44); ctx.quadraticCurveTo(x-len*0.6,y-50+fl,x-len,y-32+fl*1.5-(air?8:0));
      ctx.lineTo(x-len+8,y-8+fl); ctx.quadraticCurveTo(x-20,y-12,x-2,y-14); ctx.closePath(); ctx.fill(); ctx.stroke();
      ctx.fillStyle='#ffd23f'; ctx.beginPath(); ctx.arc(x-12,y-30,3,0,7); ctx.fill();
    } else if(costume===3){
      rr(x-28,y-46,17,30,5); ctx.fillStyle='#c6ccd8'; ctx.fill(); ctx.strokeStyle='#8a93a6'; ctx.lineWidth=2; ctx.stroke();
      ctx.fillStyle='#e03a3a'; ctx.fillRect(x-26,y-38,13,4);
      if(air){
        var fh=8+Math.random()*8;
        ctx.fillStyle='#ff9a2e'; ctx.beginPath(); ctx.moveTo(x-26,y-16); ctx.lineTo(x-13,y-16); ctx.lineTo(x-19.5,y-16+fh+6); ctx.closePath(); ctx.fill();
        ctx.fillStyle='#ffe98a'; ctx.beginPath(); ctx.moveTo(x-23,y-16); ctx.lineTo(x-16,y-16); ctx.lineTo(x-19.5,y-16+fh); ctx.closePath(); ctx.fill();
      }
    } else if(costume===5){
      var sf=Math.sin(t*12)*5, ln2=air?32:24;
      ctx.fillStyle='#d62c2c'; ctx.strokeStyle='#8a1a1a'; ctx.lineWidth=1.5;
      ctx.beginPath(); ctx.moveTo(x-11,y-63); ctx.quadraticCurveTo(x-22,y-67+sf,x-12-ln2,y-61+sf*1.5); ctx.lineTo(x-16-ln2,y-55+sf*1.5); ctx.quadraticCurveTo(x-22,y-58+sf,x-9,y-58); ctx.closePath(); ctx.fill(); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x-11,y-61); ctx.quadraticCurveTo(x-20,y-58-sf,x-8-ln2*0.7,y-50-sf*1.2); ctx.lineTo(x-12-ln2*0.7,y-45-sf*1.2); ctx.quadraticCurveTo(x-18,y-54-sf,x-9,y-56); ctx.closePath(); ctx.fill(); ctx.stroke();
    }
  }
  function costumeFront(x,y){
    if(costume===1){
      ctx.fillStyle='#e03a3a'; ctx.beginPath(); ctx.arc(x+3,y-60,16.5,Math.PI,0); ctx.closePath(); ctx.fill();
      ctx.fillStyle='#a82424'; ctx.fillRect(x-22,y-64,15,5);
      ctx.fillStyle='#fff'; ctx.beginPath(); ctx.arc(x+4,y-67,2.4,0,7); ctx.fill();
      ctx.strokeStyle='#ffd23f'; ctx.lineWidth=3; ctx.beginPath(); ctx.arc(x+3,y-37,9,0.15,Math.PI-0.15); ctx.stroke();
      ctx.fillStyle='#ffd23f'; ctx.strokeStyle='#8a5a00'; ctx.lineWidth=1.5; ctx.beginPath(); ctx.arc(x+3,y-28,3.6,0,7); ctx.fill(); ctx.stroke();
    } else if(costume===2){
      ctx.fillStyle='#1f4fc0'; ctx.beginPath(); ctx.moveTo(x-4,y-60); ctx.lineTo(x-14,y-52); ctx.lineTo(x-2,y-52); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.ellipse(x+12,y-55,13.5,6.5,0,0,7); ctx.fill();
      ctx.fillStyle='#fff'; ctx.beginPath(); ctx.ellipse(x+8,y-55,3.8,2.6,0,0,7); ctx.ellipse(x+17,y-55,3.8,2.6,0,0,7); ctx.fill();
      ctx.fillStyle='#111'; ctx.beginPath(); ctx.arc(x+9,y-55,1.4,0,7); ctx.arc(x+18,y-55,1.4,0,7); ctx.fill();
      ctx.fillStyle='#ffd23f'; ctx.strokeStyle='#8a5a00'; ctx.lineWidth=1.5; ctx.beginPath(); ctx.arc(x+2,y-26,7.5,0,7); ctx.fill(); ctx.stroke();
      ctx.strokeStyle='#d62c2c'; ctx.lineWidth=2.4; ctx.beginPath(); ctx.moveTo(x+4,y-31); ctx.lineTo(x,y-26); ctx.lineTo(x+4,y-26); ctx.lineTo(x+1,y-21); ctx.stroke();
    } else if(costume===3){
      ctx.fillStyle='#f4f6fa'; ctx.strokeStyle='#c0c8d8'; ctx.lineWidth=2; ctx.beginPath(); ctx.ellipse(x,y-25,15,17,0,0,7); ctx.fill(); ctx.stroke();
      ctx.fillStyle='#c0c8d8'; ctx.fillRect(x-6,y-30,12,8);
      ctx.fillStyle='#e03a3a'; ctx.beginPath(); ctx.arc(x-3,y-26,2,0,7); ctx.fill();
      ctx.fillStyle='#2f7ad8'; ctx.beginPath(); ctx.arc(x+3,y-26,2,0,7); ctx.fill();
      ctx.fillStyle='#dfe6f0'; ctx.beginPath(); ctx.ellipse(x+3,y-37,13,4.5,0,0,7); ctx.fill();
      ctx.fillStyle='rgba(170,215,255,.28)'; ctx.beginPath(); ctx.arc(x+3,y-52,21,0,7); ctx.fill();
      ctx.strokeStyle='#e8eef8'; ctx.lineWidth=4; ctx.beginPath(); ctx.arc(x+3,y-52,21,0,7); ctx.stroke();
      ctx.strokeStyle='rgba(255,255,255,.8)'; ctx.lineWidth=3; ctx.beginPath(); ctx.arc(x+3,y-52,15,3.5,4.5); ctx.stroke();
    } else if(costume===4){
      ctx.fillStyle='#26200f'; ctx.beginPath(); ctx.moveTo(x-19,y-60); ctx.quadraticCurveTo(x-6,y-70,x+3,y-84); ctx.quadraticCurveTo(x+14,y-70,x+27,y-60); ctx.quadraticCurveTo(x+4,y-55,x-19,y-60); ctx.closePath(); ctx.fill();
      ctx.fillStyle='#fff'; ctx.beginPath(); ctx.arc(x+4,y-68,3.2,0,7); ctx.fill();
      ctx.fillStyle='#26200f'; ctx.fillRect(x+2.2,y-69.2,1.7,1.7); ctx.fillRect(x+4.8,y-69.2,1.7,1.7);
      ctx.strokeStyle='#fff'; ctx.lineWidth=1.5; ctx.beginPath(); ctx.moveTo(x-1,y-62); ctx.lineTo(x+9,y-65.5); ctx.moveTo(x+9,y-62); ctx.lineTo(x-1,y-65.5); ctx.stroke();
      ctx.fillStyle='#111'; ctx.beginPath(); ctx.ellipse(x+7,y-55,5.6,5,0,0,7); ctx.fill();
      ctx.strokeStyle='#111'; ctx.lineWidth=1.6; ctx.beginPath(); ctx.moveTo(x+2,y-58); ctx.lineTo(x-12,y-63); ctx.stroke();
      ctx.fillStyle='#ffd23f'; ctx.beginPath(); ctx.arc(x-9,y-46,2.4,0,7); ctx.fill();
    } else if(costume===5){
      ctx.fillStyle='#1d1d26'; ctx.beginPath(); ctx.arc(x+3,y-52,17.5,0,7); ctx.fill();
      ctx.fillStyle='#f0c9a0'; rr(x-6,y-60,30,12,5); ctx.fill();
      ctx.fillStyle='#fff'; ctx.beginPath(); ctx.arc(x+7,y-55,4,0,7); ctx.arc(x+16,y-55,4,0,7); ctx.fill();
      ctx.fillStyle='#26200f'; ctx.beginPath(); ctx.arc(x+8,y-55,2,0,7); ctx.arc(x+17,y-55,2,0,7); ctx.fill();
      ctx.strokeStyle='#1d1d26'; ctx.lineWidth=2.5; ctx.beginPath(); ctx.moveTo(x+2,y-62); ctx.lineTo(x+10,y-59); ctx.moveTo(x+21,y-62); ctx.lineTo(x+13,y-59); ctx.stroke();
      ctx.fillStyle='#d62c2c'; ctx.fillRect(x-14,y-67,35,6); ctx.beginPath(); ctx.arc(x-13,y-64,3.4,0,7); ctx.fill();
    } else if(costume===6){
      var fl2=Math.sin(t*10)*3;
      ctx.fillStyle='#d6402a'; ctx.beginPath(); ctx.moveTo(x-2,y-74); ctx.quadraticCurveTo(x-16,y-88+fl2,x-27,y-71+fl2*1.5); ctx.quadraticCurveTo(x-14,y-72,x+5,y-70); ctx.closePath(); ctx.fill();
      ctx.beginPath(); ctx.ellipse(x+3,y-79,5.5,9,0,0,7); ctx.fill();
      ctx.fillStyle='#aab3c2'; ctx.strokeStyle='#6c7686'; ctx.lineWidth=2;
      ctx.beginPath(); ctx.arc(x+3,y-58,18,Math.PI,0); ctx.lineTo(x+21,y-52); ctx.lineTo(x-15,y-52); ctx.closePath(); ctx.fill(); ctx.stroke();
      ctx.fillStyle='#26323e'; ctx.fillRect(x-8,y-57,29,6);
      ctx.fillStyle='#fff'; ctx.beginPath(); ctx.arc(x+7,y-54,2.2,0,7); ctx.arc(x+16,y-54,2.2,0,7); ctx.fill();
      ctx.fillStyle='#d6dde8'; ctx.fillRect(x+2,y-71,2.4,13);
    } else if(costume===7){
      rr(x-14,y-69,34,32,6); ctx.fillStyle='#9aa7b8'; ctx.fill(); ctx.strokeStyle='#5a6577'; ctx.lineWidth=2; ctx.stroke();
      ctx.fillStyle='#10222e'; rr(x-9,y-62,26,16,4); ctx.fill();
      var bl=(t*0.7%1)<0.1;
      ctx.fillStyle='#4af0ff'; ctx.fillRect(x-4,y-58,7,bl?2:7); ctx.fillRect(x+9,y-58,7,bl?2:7);
      ctx.fillStyle='#2ab0c0'; ctx.fillRect(x-2,y-49,12,2);
      ctx.strokeStyle='#5a6577'; ctx.lineWidth=2.5; ctx.beginPath(); ctx.moveTo(x+3,y-69); ctx.lineTo(x+3,y-79); ctx.stroke();
      ctx.fillStyle=Math.floor(t*4)%2?'#ff4a4a':'#a02a2a'; ctx.beginPath(); ctx.arc(x+3,y-81,3.2,0,7); ctx.fill();
      ctx.fillStyle='#5a6577'; ctx.beginPath(); ctx.arc(x-16,y-52,3.5,0,7); ctx.arc(x+22,y-52,3.5,0,7); ctx.fill();
    }
  }
  function kissNow(){ return (state==='rescue'&&rescue&&rescue.phase==='kiss')||state==='win'; }
  function legs(x,y,col){
    var air=!p.on, sw=(air||kissNow())?0:Math.sin(t*16)*9;
    ctx.strokeStyle=col; ctx.lineWidth=7; ctx.lineCap='round';
    ctx.beginPath(); ctx.moveTo(x-5,y-14); ctx.lineTo(x-5+(air?-10:-sw),y-2); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(x+5,y-14); ctx.lineTo(x+5+(air?12:sw),y-2); ctx.stroke();
  }
  function arm(x,y,col){
    var air=!p.on, sw=(air||kissNow())?0:Math.sin(t*16)*9, shot=shootAnim>0;
    ctx.strokeStyle=col; ctx.lineWidth=6; ctx.lineCap='round'; ctx.beginPath(); ctx.moveTo(x+4,y-34);
    if(shot) ctx.lineTo(x+24,y-38); else ctx.lineTo(x+14,y-(air?50:26)+(air?0:sw*.4));
    ctx.stroke();
  }
  function costumeBody(x,y){
    if(costume<4) return;
    ctx.save();
    if(costume===4){
      legs(x,y,'#3b2a1f');
      ctx.save(); ctx.beginPath(); ctx.ellipse(x,y-28,14,18,0,0,7); ctx.clip();
      ctx.fillStyle='#f2efe6'; ctx.fillRect(x-16,y-48,32,40);
      ctx.fillStyle='#c0262d'; for(var si=0;si<5;si++) ctx.fillRect(x-16,y-46+si*8,32,4);
      ctx.restore();
      ctx.fillStyle='#26200f'; ctx.fillRect(x-14,y-20,28,4); ctx.fillStyle='#ffd23f'; ctx.fillRect(x-3,y-21,6,6);
      arm(x,y,'#f2efe6');
    } else if(costume===5){
      legs(x,y,'#1d1d26');
      ctx.fillStyle='#1d1d26'; ctx.beginPath(); ctx.ellipse(x,y-28,14,18,0,0,7); ctx.fill();
      ctx.fillStyle='#8a8f9a'; ctx.fillRect(x-14,y-26,28,4); ctx.fillStyle='#d62c2c'; ctx.fillRect(x-3,y-27,6,6);
      arm(x,y,'#1d1d26');
    } else if(costume===6){
      legs(x,y,'#8f99a8');
      ctx.fillStyle='#aab3c2'; ctx.strokeStyle='#6c7686'; ctx.lineWidth=2; ctx.beginPath(); ctx.ellipse(x,y-28,14,18,0,0,7); ctx.fill(); ctx.stroke();
      ctx.fillStyle='#d6dde8'; ctx.beginPath(); ctx.ellipse(x-4,y-32,4,9,0.2,0,7); ctx.fill();
      ctx.fillStyle='#c0262d'; ctx.fillRect(x-1.5,y-38,3,16); ctx.fillRect(x-6,y-33,12,3);
      arm(x,y,'#aab3c2');
    } else {
      legs(x,y,'#7a8696');
      rr(x-12,y-44,24,32,4); ctx.fillStyle='#9aa7b8'; ctx.fill(); ctx.strokeStyle='#5a6577'; ctx.lineWidth=2; ctx.stroke();
      ctx.fillStyle='#10222e'; ctx.fillRect(x-7,y-38,14,8);
      ctx.fillStyle=Math.floor(t*3)%2?'#4af0ff':'#2ab0c0'; ctx.fillRect(x-5,y-36,4,4); ctx.fillRect(x+1,y-36,4,4);
      ctx.fillStyle='#e03a3a'; ctx.beginPath(); ctx.arc(x,y-24,3,0,7); ctx.fill();
      arm(x,y,'#9aa7b8');
    }
    ctx.restore();
  }
  function mic(x,y){
    ctx.strokeStyle='#555'; ctx.lineWidth=4; ctx.beginPath(); ctx.moveTo(x+24,y-38); ctx.lineTo(x+30,y-28); ctx.stroke();
    ctx.fillStyle='#222'; ctx.beginPath(); ctx.arc(x+23,y-41,4.5,0,7); ctx.fill();
    ctx.fillStyle='#aaa'; ctx.beginPath(); ctx.arc(x+22,y-42,1.6,0,7); ctx.fill();
  }
  function barrier(cx,w,h,ph,cl){
    cl=cl||['#ff3ea5','#00e5ff'];
    var b=GROUND+2, hh=h*(1+0.04*Math.sin(t*14+ph)), x0=cx-w/2;
    var gr=ctx.createLinearGradient(0,b-hh,0,b); gr.addColorStop(0,cl[0]); gr.addColorStop(1,cl[1]);
    ctx.save(); ctx.globalAlpha=0.28; ctx.fillStyle=gr; ctx.fillRect(x0-6,b-hh-6,w+12,hh+6); ctx.globalAlpha=1;
    ctx.fillStyle=gr; ctx.fillRect(x0,b-hh,w,hh);
    ctx.fillStyle='rgba(255,255,255,.55)'; for(var k=0;k<4;k++){ var yy=b-((t*90+k*hh/4+ph*7)%hh); ctx.fillRect(x0,yy,w,2); }
    ctx.strokeStyle='#fff'; ctx.lineWidth=2; ctx.strokeRect(x0,b-hh,w,hh);
    ctx.fillStyle='#12182a'; ctx.fillRect(x0-4,b-8,w+8,8); ctx.fillStyle=cl[0]; ctx.fillRect(x0-4,b-hh-6,w+8,6);
    ctx.restore();
  }
  function flame(cx,w,h,ph){
    if(world===2){ barrier(cx,w,h,ph); return; }
    var ok=WX[world]&&WX[world].obst;
    if(ok==='laser'){ barrier(cx,w,h,ph,['#7aff5a','#5a6aff']); return; }
    if(ok&&ok!=='lava'){ themeObst(cx,w,h,ph,ok); return; }
    var fc=ok==='lava'?['#fff2a0','#ff7a1a','#a01a0a','#ffe0a0']:world===3?['#d8ffb0','#8a3aff','#3a1a7a','#f2ffe0']:['#ffd23f','#ff6b2c','#d62c2c','#ffe98a'];
