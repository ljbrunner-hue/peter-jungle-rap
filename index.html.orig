          for(var k=-1;k<=1;k++){ bR(x+k*18-3,cy0-14,6,12,'#efe8d8',2); var fl=6+2*Math.sin(t*15+k+idx); bP('#ffb03a',[x+k*18-3,cy0-14,x+k*18,cy0-14-fl,x+k*18+3,cy0-14]); bG(x+k*18,cy0-18,22,'#ffb03a',0.4); } });
