    ctx.strokeStyle=gold?'#fff07a':'#ffd23f'; ctx.lineWidth=6; ctx.beginPath(); ctx.arc(0,6,13,Math.PI*1.1,Math.PI*1.9); ctx.stroke();
    if(gold){ ctx.strokeStyle='rgba(255,255,255,.85)'; ctx.lineWidth=1.8; ctx.beginPath(); ctx.arc(0,4,13,Math.PI*1.2,Math.PI*1.6); ctx.stroke(); }
    ctx.restore();
