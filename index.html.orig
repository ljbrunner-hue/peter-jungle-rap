    ctx.fillStyle=g; ctx.beginPath(); ctx.arc(x,y,r,0,7); ctx.fill();
  }
  function powBanana(pw){
    var pulse=0.5+0.5*Math.sin(t*6+pw.ph), y=GROUND-pw.h+Math.sin(t*3+pw.ph)*4;
    glow(pw.x,y,32,0.5+0.3*pulse);
    banana(pw.x,y,Math.sin(t*2+pw.ph)*0.4,1.7,true);
    for(var i=0;i<3;i++){ var a=t*2.4+i*2.1; sparkle(pw.x+Math.cos(a)*24,y+Math.sin(a)*22,3+2*Math.sin(t*8+i)); }
