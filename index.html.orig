  function peter(){
    var PL=previewPl>=0?previewPl:((platOn[costume]&&plat[costume])?1:0), FUR=PL?'#aeb9c6':'#8a5a2b', FACE=PL?'#f2f6fa':'#f0c9a0', x=px, y=p.y, ph=t*16, air=!p.on, kiss=state==='rescue'&&rescue.phase==='kiss'||state==='win';
    var sw=(air||kiss)?0:Math.sin(ph)*9, shot=shootAnim>0;
    ctx.lineCap='round';
    ctx.strokeStyle=FUR; ctx.lineWidth=5; ctx.beginPath(); ctx.moveTo(x-12,y-22);
    ctx.quadraticCurveTo(x-36,y-8+(air||kiss?-8:Math.sin(ph)*4),x-30,y-42); ctx.stroke();
    ctx.lineWidth=7;
    ctx.beginPath(); ctx.moveTo(x-5,y-14); ctx.lineTo(x-5+(air?-10:-sw),y-2); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(x+5,y-14); ctx.lineTo(x+5+(air?12:sw),y-2); ctx.stroke();
    ctx.fillStyle=FUR; ctx.beginPath(); ctx.ellipse(x,y-28,14,18,0,0,7); ctx.fill();
    ctx.fillStyle=FACE; ctx.beginPath(); ctx.ellipse(x+3,y-24,8,12,0,0,7); ctx.fill();
    ctx.strokeStyle=FUR; ctx.lineWidth=6;
    ctx.beginPath(); ctx.moveTo(x+4,y-34);
    if(shot) ctx.lineTo(x+24,y-38); else ctx.lineTo(x+14,y-(air?50:26)+(air?0:sw*.4));
    ctx.stroke();
    costumeBody(x,y);
    ctx.fillStyle=FUR; ctx.beginPath(); ctx.arc(x-9,y-54,7,0,7); ctx.fill(); ctx.beginPath(); ctx.arc(x+15,y-56,7,0,7); ctx.fill();
    ctx.fillStyle=FACE; ctx.beginPath(); ctx.arc(x-9,y-54,3.5,0,7); ctx.fill(); ctx.beginPath(); ctx.arc(x+15,y-56,3.5,0,7); ctx.fill();
    ctx.fillStyle=FUR; ctx.beginPath(); ctx.arc(x+3,y-52,16,0,7); ctx.fill();
    ctx.fillStyle=FACE; ctx.beginPath(); ctx.ellipse(x+8,y-49,11,10,0,0,7); ctx.fill();
    ctx.fillStyle='#fff'; ctx.beginPath(); ctx.arc(x+7,y-55,4,0,7); ctx.arc(x+16,y-55,4,0,7); ctx.fill();
    ctx.fillStyle='#26200f'; ctx.beginPath(); ctx.arc(x+8,y-55,2,0,7); ctx.arc(x+17,y-55,2,0,7); ctx.fill();
    ctx.strokeStyle='#26200f'; ctx.lineWidth=2; ctx.beginPath();
    if(state==='dead') ctx.arc(x+12,y-41,4,Math.PI,0); else ctx.arc(x+12,y-47,5,.2,Math.PI-.2);
    ctx.stroke();
    costumeFront(x,y);
    if(costume===1&&music.rapping()) mic(x,y);
    if(kiss) heart(x+17,y-45,5,'#e0235a');
    if(PL){
