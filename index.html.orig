  function drawBoss(b){
    var x=b.x+(b.flash>0?Math.sin(t*80)*4:0), gy=GROUND, hit=b.flash>0;
    ctx.save();
    if(b.phase==='dying'){
      ctx.translate(x,gy); ctx.rotate(Math.min(1,b.dead/1.2)*1.4); ctx.translate(-x,-gy);
      ctx.globalAlpha=1-Math.max(0,(b.dead-0.9)/0.5);
