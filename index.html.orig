  function drawTire(cx,cy,r,rot){
    if(world===2){ drawBall(cx,cy,r,'saw',rot); return; }
    if(world===3){ drawBall(cx,cy,r,'pumpkin',rot); return; }
    if(WX[world]){ drawBall(cx,cy,r,WX[world].roll,rot); return; }
