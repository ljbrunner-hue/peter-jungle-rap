    ctx.restore();
    /* goldene Banane */
    ctx.save();
    ctx.strokeStyle='#14110a'; ctx.lineWidth=13; ctx.beginPath(); ctx.arc(38,-14,15,Math.PI*1.12,Math.PI*1.9); ctx.stroke();
    var bg=ctx.createLinearGradient(24,-30,54,-18); bg.addColorStop(0,'#ffe27a'); bg.addColorStop(0.5,'#ffc61f'); bg.addColorStop(1,'#d9981a');
    ctx.strokeStyle=bg; ctx.lineWidth=8.5; ctx.beginPath(); ctx.arc(38,-14,15,Math.PI*1.12,Math.PI*1.9); ctx.stroke();
    ctx.strokeStyle='#fff7c9'; ctx.lineWidth=2; ctx.beginPath(); ctx.arc(38,-15.5,14,Math.PI*1.22,Math.PI*1.55); ctx.stroke();
    ctx.fillStyle='#5a3a12'; ctx.beginPath(); ctx.arc(24.3,-21,3,0,7); ctx.fill();
    ctx.fillStyle='#fff'; var sx=60,sy=-12,sr=3; ctx.beginPath(); ctx.moveTo(sx,sy-sr*2); ctx.lineTo(sx+sr*.6,sy-sr*.6); ctx.lineTo(sx+sr*2,sy); ctx.lineTo(sx+sr*.6,sy+sr*.6); ctx.lineTo(sx,sy+sr*2); ctx.lineTo(sx-sr*.6,sy+sr*.6); ctx.lineTo(sx-sr*2,sy); ctx.lineTo(sx-sr*.6,sy-sr*.6); ctx.closePath(); ctx.fill();
    ctx.restore();
    ctx.strokeStyle='#e8b923'; ctx.lineWidth=3.2; ctx.beginPath(); ctx.ellipse(0,0,RX-2,RY-2,0,0,7); ctx.stroke();
    ctx.strokeStyle='rgba(232,185,35,.55)'; ctx.lineWidth=1.2; ctx.beginPath(); ctx.ellipse(0,0,RX-6,RY-6,0,0,7); ctx.stroke();
    ctx.restore();
  }
  function priceTag(R,price){
    var str=String(price), cy=R.y+R.h/2;
    ctx.font='700 21px "Fredoka","Trebuchet MS",sans-serif';
    var w=ctx.measureText(str).width;
    txt(str,R.x+R.w-16,cy+7,21,'#ffd23f','right');
    banana(R.x+R.w-16-w-24,cy,0.3,1.1,true);
  }
  function rr(x,y,w,h,r){ ctx.beginPath(); ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }
  function btn(R,label,sub,col,on,right){
    ctx.save();
    rr(R.x,R.y+4,R.w,R.h,12); ctx.fillStyle='#26200f'; ctx.fill();
    rr(R.x,R.y,R.w,R.h,12); ctx.fillStyle=col; ctx.fill(); ctx.lineWidth=on?5:3; ctx.strokeStyle=on?'#fff':'#26200f'; ctx.stroke();
    ctx.restore();
    txt(label,R.x+R.w/2,R.y+(sub?24:R.h/2+7),sub?22:19,'#fff');
    if(sub) txt(sub,R.x+R.w/2,R.y+40,13,'#fff');
    if(right) txt(right,R.x+R.w-12,R.y+18,13,'#fff','right');
    if(on){ ctx.fillStyle='#fff'; ctx.beginPath(); ctx.moveTo(R.x+12,R.y+R.h/2-8); ctx.lineTo(R.x+24,R.y+R.h/2); ctx.lineTo(R.x+12,R.y+R.h/2+8); ctx.closePath(); ctx.fill(); }
  }
  function menuRects(){
    var top=Math.max(0,(GROUND-300)/2), bw=Math.min(330,W-40), x=(W-bw)/2, r=[];
    for(var i=0;i<3;i++) r.push({x:x,y:top+106+i*54,w:bw,h:46});
    return {r:r,top:top,c:{x:10,y:top+106,w:135,h:62}};
  }
  function endRects(){
    var cy=Hw*0.30, y=cy+(state==='win'?96:(almost.length?108:84));
    return [{x:W/2-210,y:y,w:200,h:44},{x:W/2+10,y:y,w:200,h:44}];
  }
  function inR(R,g){ return g.x>=R.x&&g.x<=R.x+R.w&&g.y>=R.y&&g.y<=R.y+R.h; }

  /* ===== Kompakte Spielanzeige ===== */
  function hudBar(x,y,w,f,col,blink){
    rr(x,y,w,6,3); ctx.fillStyle='rgba(0,0,0,.45)'; ctx.fill();
    if(f>0.02){ rr(x,y,w*Math.min(1,f),6,3); ctx.fillStyle=blink&&Math.floor(t*8)%2?'#fff':col; ctx.fill(); }
  }
  function hudMid(){ return (216+W-130)/2; }
  function drawHud(){
    var i, rows=[], x0=10, y0=8, pw=196;
    if(combo>0) rows.push('combo');
    if(giantT>0) rows.push('giant'); else if(giantLeft>0) rows.push('collect');
    if(power>0) rows.push('power');
    var ph=46+rows.length*15;
    rr(x0,y0,pw,ph,10); ctx.fillStyle='rgba(15,20,25,.32)'; ctx.fill();
    txt(score.toLocaleString('de-DE'),x0+10,y0+23,19,'#fff','left');
    txt('Rekord '+fmt(bests[di]),x0+pw-10,y0+20,11,'#ffd23f','right');
    var dc=diff.col==='#e6a800'?'#ffd23f':diff.col==='#d6402a'?'#ff7a5a':'#9be05a';
    txt('Lv '+lvlNum()+'/'+NLV+' · '+lvName(lvlNum()),x0+10,y0+39,11,'#fff','left');
    txt(diff.name,x0+pw-10,y0+39,11,dc,'right');
    for(i=0;i<rows.length;i++){
      var ry=y0+52+i*15, k;
      if(rows[i]==='giant'){ txt('Riese',x0+10,ry+4,10,'#ffd23f','left'); hudBar(x0+52,ry-3,pw-62,giantT/7,'#ff9a2e',giantT<1.5); }
      else if(rows[i]==='collect'){
        for(k=0;k<5;k++){ ctx.globalAlpha=k<pCount?1:0.35; banana(x0+18+k*15,ry,0.3,0.45,k<pCount); }
        ctx.globalAlpha=1; txt('Riese '+giantLeft+'x',x0+pw-10,ry+4,10,'#fff','right');
      }
      else if(rows[i]==='combo'){ var cm=cMult(); txt('Combo '+combo+'  x'+cm,x0+10,ry+4,11,cm>=6?'#ff7a5a':cm>=3?'#ff9a2e':'#fff','left'); hudBar(x0+108,ry-3,pw-118,comboT/4,'#ff9a2e',comboT<1.2); }
      else { txt('Power',x0+10,ry+4,10,'#ffd23f','left'); hudBar(x0+52,ry-3,pw-62,power/14,'#ffd23f',power<3); }
    }
    /* oben rechts: Bananen + Pause */
    var bx=(state==='play'||state==='pause')?W-52:W-12, str=fmt(bananas);
    ctx.font='700 16px "Fredoka","Trebuchet MS",sans-serif';
    var bw=ctx.measureText(str).width;
    txt(str,bx,32,16,'#ffd23f','right'); banana(bx-bw-14,26,0.3,0.75,true);
    if(state==='play'||state==='pause') drawPauseBtn();
    if(boss) bossBar(boss);
    /* Liedzeile: dezent oben in der Mitte */
    var ln=music.line();
    if(ln){
      ctx.globalAlpha=0.85*Math.min(1,Math.max(0,(3.6-ln.age)/0.6));
      txt(ln.text,hudMid(),boss?66:26,ln.hook?17:13,ln.hook?'#ffd23f':'#fff'); ctx.globalAlpha=1;
    }
    if(slowT>0&&state==='play'){ ctx.fillStyle='rgba(80,120,255,.12)'; ctx.fillRect(0,0,W,Hw); }
    if(spFlash>0){ ctx.globalAlpha=Math.min(0.6,spFlash*2); ctx.fillStyle='#fff'; ctx.fillRect(0,0,W,Hw); ctx.globalAlpha=1; }
    if(specAvail()){
      var SR=specRect(), rdy=spCd<=0, fr=rdy?1:1-Math.max(0,spCd)/specCdMax();
      ctx.save();
      rr(SR.x,SR.y,SR.w,SR.h,10); ctx.fillStyle='rgba(15,20,25,.55)'; ctx.fill();
      ctx.save(); rr(SR.x,SR.y,SR.w,SR.h,10); ctx.clip(); ctx.fillStyle=rdy?'#4a7de0':'rgba(74,125,224,.45)'; ctx.fillRect(SR.x,SR.y,SR.w*fr,SR.h); ctx.restore();
      rr(SR.x,SR.y,SR.w,SR.h,10); ctx.lineWidth=rdy?2.5:1.5; ctx.strokeStyle=rdy?'#fff':'rgba(255,255,255,.4)'; ctx.stroke();
      txt((touch?'':'S · ')+SPEC[costume].n,SR.x+SR.w/2,SR.y+SR.h/2+4,12,rdy?'#fff':'rgba(255,255,255,.75)');
      ctx.restore();
    }
    if(giantReady()){
      var GR=giantRect(), pl2=1+0.03*Math.sin(t*9);
      ctx.save(); ctx.translate(GR.x+GR.w/2,GR.y+GR.h/2); ctx.scale(pl2,pl2); ctx.translate(-GR.x-GR.w/2,-GR.y-GR.h/2);
      rr(GR.x,GR.y,GR.w,GR.h,10); ctx.fillStyle='#d6402a'; ctx.fill(); ctx.lineWidth=2.5; ctx.strokeStyle='#fff'; ctx.stroke();
      txt(touch?'RIESEN-PETER!':'RIESEN-PETER (W)',GR.x+GR.w/2,GR.y+GR.h/2+5,14,'#fff');
      ctx.restore();
    }
  }
  function bossBar(b){
    var cx=hudMid(), bw=Math.min(260,W-346), bx=cx-bw/2, by=26;
    txt(b.L.bname+(b.wut?' · WUT':''),cx,by-6,13,b.wut?'#ff9a7a':'#fff');
    rr(bx-2,by-2,bw+4,14,6); ctx.fillStyle='rgba(15,20,25,.55)'; ctx.fill();
    rr(bx,by,bw,10,5); ctx.fillStyle='#7a2020'; ctx.fill();
    if(b.shown>0.01){ rr(bx,by,bw*Math.max(0,b.shown),10,5); ctx.fillStyle=b.rage?'#ff7a1a':'#e03a3a'; ctx.fill(); }
    txt(fmt(b.hp),cx,by+24,11,'#fff');
  }
  function bossBarOld(b){
    var bw=Math.min(300,W*0.5), bx=W-bw-20, by=96;
    txt(b.L.bname+(b.wut?' · WUT':''),W-20,88,18,b.wut?'#ff9a7a':'#fff','right');
    ctx.fillStyle='#26200f'; ctx.fillRect(bx-3,by-3,bw+6,26);
    ctx.fillStyle='#7a2020'; ctx.fillRect(bx,by,bw,20);
    ctx.fillStyle=b.rage?'#ff7a1a':'#e03a3a'; ctx.fillRect(bx,by,bw*Math.max(0,b.shown),20);
    ctx.fillStyle='#26200f'; for(var i=1;i<5;i++) ctx.fillRect(bx+bw*i/5-1,by,2,20);
    txt(fmt(b.hp)+' / '+fmt(b.max),bx+bw/2,by+16,15);
  }

  /* ===== Hintergründe für Welt 2 (Cyber) und Welt 3 (Vampir/Halloween) ===== */
  function hash(n){ var s=Math.sin(n*127.1+311.7)*43758.5453; return s-Math.floor(s); }
  function starsBack(n,col){
    ctx.fillStyle=col;
    for(var i=0;i<n;i++){ var sx=hash(i)*W, sy=hash(i+50)*(GROUND*0.62), tw=0.5+0.5*Math.sin(t*2+i); ctx.globalAlpha=0.35+0.55*tw; ctx.fillRect(sx,sy,1.6,1.6); }
    ctx.globalAlpha=1;
  }
  function cyberBack(pal){
    var i, acc=pal.grass;
    starsBack(36,'#ffffff');
    /* Neon-Sonne mit Streifen */
    var sg=ctx.createLinearGradient(0,40,0,100); sg.addColorStop(0,'#fff6c0'); sg.addColorStop(1,pal.sun);
    ctx.fillStyle=sg; ctx.beginPath(); ctx.arc(W-90,78,38,0,7); ctx.fill();
    ctx.fillStyle=pal.sky2; for(i=0;i<4;i++) ctx.fillRect(W-130,84+i*7,80,2+i*1.2);
    /* Skyline in zwei Ebenen */
    for(var layer=0;layer<2;layer++){
      var sp=layer?0.22:0.1, bw=layer?46:34, off=(dist*sp)%(bw*14);
      ctx.fillStyle=layer?pal.hill:'rgba(0,0,0,0.35)';
      for(var k=-1;k<W/bw+16;k++){
        var idx=Math.floor((off/bw)+k), hh=(layer?44:70)+hash(idx+layer*40)*(layer?70:80), bx=k*bw-(off%bw);
        ctx.fillStyle=layer?pal.hill:'rgba(10,6,30,0.55)'; ctx.fillRect(bx,GROUND-hh,bw-4,hh);
        if(layer){
          ctx.fillStyle=acc; ctx.globalAlpha=0.9; ctx.fillRect(bx,GROUND-hh,bw-4,2); ctx.globalAlpha=1;
          for(var wy=GROUND-hh+8;wy<GROUND-8;wy+=9) for(var wx=bx+5;wx<bx+bw-10;wx+=10){ if(hash(idx*13+wy+wx)>0.55){ ctx.fillStyle=hash(idx+wy)>0.7?'#ffffff':acc; ctx.globalAlpha=0.55+0.4*Math.sin(t*2+wx+wy); ctx.fillRect(wx,wy,4,4); } }
          ctx.globalAlpha=1;
        }
      }
    }
  }
  function cyberGround(pal){
    var acc=pal.grass;
    ctx.fillStyle=pal.dirt; ctx.fillRect(-20,GROUND,W+40,Hw-GROUND+30);
    ctx.save(); ctx.globalAlpha=0.35; var gg=ctx.createLinearGradient(0,GROUND,0,GROUND+22); gg.addColorStop(0,acc); gg.addColorStop(1,'rgba(0,0,0,0)'); ctx.fillStyle=gg; ctx.fillRect(-20,GROUND,W+40,22); ctx.restore();
    ctx.fillStyle=acc; ctx.fillRect(-20,GROUND,W+40,3);
    ctx.strokeStyle=pal.dirt2; ctx.lineWidth=2;
    var off=dist%60, vp=W/2;
    for(var k=-12;k<=12;k++){ var gx=vp+(k*60-off)*1.0; ctx.beginPath(); ctx.moveTo(vp+(gx-vp)*0.25,GROUND+4); ctx.lineTo(vp+(gx-vp)*2.6,Hw+20); ctx.stroke(); }
    for(var j=1;j<5;j++){ var gy2=GROUND+4+Math.pow(j/4,1.8)*(Hw-GROUND+16); ctx.beginPath(); ctx.moveTo(-20,gy2); ctx.lineTo(W+20,gy2); ctx.stroke(); }
  }
  function vampBack(pal){
    var i, k;
    starsBack(30,'#fff6dd');
    /* Mond mit Hof und Kratern */
    var mx=W-92, my=72, mg=ctx.createRadialGradient(mx,my,20,mx,my,86); mg.addColorStop(0,'rgba(255,240,200,.35)'); mg.addColorStop(1,'rgba(255,240,200,0)');
    ctx.fillStyle=mg; ctx.beginPath(); ctx.arc(mx,my,86,0,7); ctx.fill();
    ctx.fillStyle=pal.sun; ctx.beginPath(); ctx.arc(mx,my,34,0,7); ctx.fill();
    ctx.fillStyle='rgba(0,0,0,.12)'; ctx.beginPath(); ctx.arc(mx-10,my-8,7,0,7); ctx.arc(mx+11,my+9,9,0,7); ctx.arc(mx+8,my-14,4,0,7); ctx.fill();
    /* dunkle Wolken */
    ctx.fillStyle='rgba(10,5,20,.55)';
    clouds.forEach(function(c){ ctx.beginPath(); ctx.ellipse(c.x,c.y+10,50*c.s,12*c.s,0,0,7); ctx.ellipse(c.x+24*c.s,c.y+4*c.s,30*c.s,12*c.s,0,0,7); ctx.fill(); });
    /* Fledermäuse am Himmel */
    ctx.fillStyle='#0c0614';
    for(i=0;i<4;i++){ var bx=((t*38*(0.7+i*0.2)+i*170)%(W+80))-40, by2=60+i*26+Math.sin(t*2+i)*14, fl=Math.sin(t*14+i*2)*5; ctx.beginPath(); ctx.moveTo(bx,by2); ctx.lineTo(bx-11,by2-5-fl); ctx.lineTo(bx-6,by2+2); ctx.lineTo(bx,by2+1); ctx.lineTo(bx+6,by2+2); ctx.lineTo(bx+11,by2-5-fl); ctx.closePath(); ctx.fill(); }
    /* ferne Burg */
    var cx0=((W*0.3)-(dist*0.03)%(W*1.6)); if(cx0<-140) cx0+=W*1.6;
    ctx.fillStyle='#0a0412'; ctx.fillRect(cx0,GROUND-120,90,100); ctx.fillRect(cx0-14,GROUND-150,26,130); ctx.fillRect(cx0+78,GROUND-170,26,150);
    ctx.beginPath(); ctx.moveTo(cx0-18,GROUND-150); ctx.lineTo(cx0-1,GROUND-184); ctx.lineTo(cx0+16,GROUND-150); ctx.fill(); ctx.beginPath(); ctx.moveTo(cx0+74,GROUND-170); ctx.lineTo(cx0+91,GROUND-206); ctx.lineTo(cx0+108,GROUND-170); ctx.fill();
    ctx.fillStyle='#ffb23a'; ctx.globalAlpha=0.8; ctx.fillRect(cx0+10,GROUND-100,6,10); ctx.fillRect(cx0+40,GROUND-86,6,10); ctx.fillRect(cx0-4,GROUND-130,5,9); ctx.fillRect(cx0+86,GROUND-150,5,9); ctx.globalAlpha=1;
    /* Hügel + Grabsteine */
    ctx.fillStyle=pal.hill; ctx.beginPath(); ctx.moveTo(-20,GROUND);
    for(var x=-20;x<=W+20;x+=20) ctx.lineTo(x,GROUND-34-Math.sin((x+dist*0.15)/80)*18-Math.sin((x+dist*0.15)/31)*5);
    ctx.lineTo(W+20,GROUND); ctx.fill();
    var off=(dist*0.15)%160;
    for(k=-1;k<W/80+3;k++){
      var idx=Math.floor((dist*0.15)/80)+k, gx=k*80-(off%80)+hash(idx)*30, kind=hash(idx+9);
      var gyy=GROUND-34-Math.sin((gx+dist*0.15)/80)*18-Math.sin((gx+dist*0.15)/31)*5+4;
      if(kind<0.4){ ctx.fillStyle='#14101c'; ctx.fillRect(gx-5,gyy-22,10,24); ctx.beginPath(); ctx.arc(gx,gyy-22,5,Math.PI,0); ctx.fill(); }
      else if(kind<0.7){ ctx.fillStyle='#14101c'; ctx.fillRect(gx-2,gyy-30,4,32); ctx.fillRect(gx-9,gyy-24,18,4); }
      else { ctx.strokeStyle='#0c0614'; ctx.lineWidth=4; ctx.lineCap='round'; ctx.beginPath(); ctx.moveTo(gx,gyy+2); ctx.lineTo(gx,gyy-34); ctx.moveTo(gx,gyy-20); ctx.lineTo(gx-12,gyy-34); ctx.moveTo(gx,gyy-26); ctx.lineTo(gx+11,gyy-40); ctx.moveTo(gx-8,gyy-30); ctx.lineTo(gx-12,gyy-42); ctx.stroke(); }
    }
    /* Nebel */
    var fg=ctx.createLinearGradient(0,GROUND-50,0,GROUND); fg.addColorStop(0,'rgba(200,190,255,0)'); fg.addColorStop(1,'rgba(200,190,255,.22)'); ctx.fillStyle=fg; ctx.fillRect(-20,GROUND-50,W+40,50);
  }
  function vampGround(pal){
    ctx.fillStyle=pal.grass; ctx.fillRect(-20,GROUND,W+40,14);
    ctx.fillStyle=pal.dirt; ctx.fillRect(-20,GROUND+14,W+40,Hw-GROUND+30);
    ctx.fillStyle=pal.dirt2;
    for(var k=0;k<W+60;k+=60){ var gx=k-(dist%60); ctx.fillRect(gx,GROUND+30,24,5); ctx.beginPath(); ctx.arc(gx+36,GROUND+46,4,0,7); ctx.fill(); }
    ctx.fillStyle='rgba(120,255,160,.12)'; ctx.fillRect(-20,GROUND-3,W+40,3);
  }
  /* ===== Themen-Hindernisse der Welten 4 bis 13 ===== */
  var curObsK='';
  function themeObst(cx,w,h,ph,k){
    var b=GROUND+2, x0=cx-w/2, i, a;
    if(k==='ice'){
      bP('#7ab8e8',[x0-2,b,cx-w*0.2,b-h*0.68,cx,b]);
      bP('#b8e4ff',[cx-w*0.32,b,cx,b-h,cx+w*0.32,b]);
      bP('#8ac8f0',[cx,b,cx+w*0.24,b-h*0.6,x0+w+2,b]);
      bP('rgba(255,255,255,.75)',[cx-w*0.08,b-h*0.3,cx,b-h,cx+w*0.05,b-h*0.36]);
      sparkle(cx+w*0.12,b-h*0.7+Math.sin(t*3+ph)*3,2.5+Math.sin(t*5+ph));
    } else if(k==='cactus'){
      var tw=w*0.44, cg='#3a9a4a', cd='#2a7a3a';
      bR(cx-tw/2-13,b-h*0.6,15,8,cg,4); bR(cx-tw/2-13,b-h*0.86,9,h*0.3,cg,4.5);
      bR(cx+tw/2-2,b-h*0.42,15,8,cg,4); bR(cx+tw/2+4,b-h*0.68,9,h*0.3,cg,4.5);
      bR(cx-tw/2,b-h,tw,h,cg,tw/2); bL(cd,2,[cx,b-h+6,cx,b-4]); bL(cd,1.5,[cx-tw*0.25,b-h+10,cx-tw*0.25,b-4]); bL(cd,1.5,[cx+tw*0.25,b-h+10,cx+tw*0.25,b-4]);
      ctx.fillStyle='#f4f0c0'; for(i=0;i<5;i++){ ctx.fillRect(cx-tw/2-3,b-h+10+i*h/6,4,1.3); ctx.fillRect(cx+tw/2-1,b-h+14+i*h/6,4,1.3); }
      if(h>60) bC(cx,b-h+2,4.5,'#ff5a8a');
    } else if(k==='coral'){
      var CO=['#ff6a8a','#ff9a3a','#c86aff'], cc=CO[Math.abs(Math.round(ph))%3];
      bL(cc,8,[cx,b,cx,b-h*0.55,cx-w*0.3,b-h*0.86]); bL(cc,7,[cx,b-h*0.5,cx+w*0.3,b-h]); bL(cc,6,[cx,b-h*0.3,cx-w*0.4,b-h*0.5]); bL(cc,5,[cx+w*0.3,b-h,cx+w*0.42,b-h*0.84]);
      bC(cx-w*0.3,b-h*0.86,4,'#fff4f8'); bC(cx+w*0.3,b-h,4,'#fff4f8');
      ctx.strokeStyle='#2a1a4a'; ctx.lineWidth=2; for(i=0;i<12;i++){ a=Math.PI+i*Math.PI/11; ctx.beginPath(); ctx.moveTo(cx,b-6); ctx.lineTo(cx+Math.cos(a)*w*0.5,b-6+Math.sin(a)*w*0.42); ctx.stroke(); }
      bC(cx,b-6,w*0.26,'#3a2a6a');
    } else if(k==='lolli'){
      var LC=['#ff3a8a','#3ab0ff','#7ad84a','#ffb03a'], lc=LC[Math.abs(Math.round(ph*7))%4], r0=Math.min(w*0.5,18);
      bR(cx-2.5,b-h+r0,5,h-r0,'#f4ecd8',2); bC(cx,b-h+r0,r0,lc);
      ctx.strokeStyle='#fff'; ctx.lineWidth=3; ctx.beginPath(); for(a=0;a<10;a+=0.3){ var r2=a*r0/10; ctx.lineTo(cx+Math.cos(a+t*2)*r2,b-h+r0+Math.sin(a+t*2)*r2); } ctx.stroke();
      bE(cx-r0*0.35,b-h+r0*0.6,r0*0.25,r0*0.15,'rgba(255,255,255,.5)',-0.5);
    } else if(k==='barrel'){
