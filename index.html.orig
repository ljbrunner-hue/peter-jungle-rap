        scrollI(1,80,function(x,idx){ ctx.fillStyle='#ffd23f'; ctx.save(); ctx.translate(x+40,GROUND+3); ctx.beginPath(); for(var i=0;i<10;i++){ var a=i*Math.PI/5-Math.PI/2, rr0=i%2?1.5:3.5; ctx.lineTo(Math.cos(a)*rr0,Math.sin(a)*rr0); } ctx.fill(); ctx.restore();
          ctx.fillStyle='rgba(160,120,60,.35)'; ctx.fillRect(x+10,GROUND+24+hash(idx)*30,18,2); });
      }}
  };
  /* Overlays: Sandsturm, Unterwasser, Dunkelheit */
  var runT=0, slideV=0, slideX=0, BDOWN=false;
  function cyc(per,on,len){ var ph=runT%per; if(ph<on||ph>on+len) return 0; return Math.min(1,(ph-on)/0.8,(on+len-ph)/0.8); }
  function stormA(){ return world===5?cyc(18,11,5):0; }
  function darkA(){ return world===11?cyc(15,9,4.5):0; }
  function worldOverlay(){
    if(!inGame()) return;
    if(world===6){ ctx.fillStyle='rgba(20,90,160,.12)'; ctx.fillRect(-20,-20,W+40,Hw+40); }
    var sa=stormA();
    if(sa>0.01){
      var sg=ctx.createLinearGradient(0,0,W,0); sg.addColorStop(0,'rgba(220,170,100,'+0.2*sa+')'); sg.addColorStop(0.5,'rgba(220,170,100,'+0.55*sa+')'); sg.addColorStop(1,'rgba(210,160,90,'+0.82*sa+')');
      ctx.fillStyle=sg; ctx.fillRect(-20,-20,W+40,Hw+40);
      ctx.strokeStyle='rgba(255,230,180,'+0.6*sa+')'; ctx.lineWidth=1.5;
      for(var i=0;i<30;i++){ var sx=((hash(i)*W*1.5-t*600*(0.6+hash(i+3)))%(W+80)+W+80)%(W+80)-40, sy=hash(i+20)*GROUND*1.1; ctx.beginPath(); ctx.moveTo(sx,sy); ctx.lineTo(sx+30,sy+2); ctx.stroke(); }
    }
    var da=darkA();
    if(da>0.01){
      var cx=px, cy=p.y-40*gs, dg=ctx.createRadialGradient(cx,cy,60,cx,cy,250);
      dg.addColorStop(0,'rgba(6,0,16,0)'); dg.addColorStop(0.55,'rgba(6,0,16,'+0.75*da+')'); dg.addColorStop(1,'rgba(6,0,16,'+0.94*da+')');
      ctx.fillStyle=dg; ctx.fillRect(-20,-20,W+40,Hw+40);
    }
  }
  function worldWarn(){
    if(!inGame()||state!=='play') return;
    var ph;
    if(world===5){ ph=runT%18; if(ph>9&&ph<11) txt('Sandsturm zieht auf!',W/2,Hw*0.42,18,'#ffd08a'); }
    if(world===11){ ph=runT%15; if(ph>7.2&&ph<9) txt('Gleich geht das Licht aus …',W/2,Hw*0.42,18,'#c8a0ff'); }
  }
  function draw(){
    var L=curLv(), pal=L.pal, i;
    ctx.save();
    if(shake>0) ctx.translate((Math.random()-.5)*10*Math.min(1,shake*3),(Math.random()-.5)*10*Math.min(1,shake*3));
    if(wxv('rock',0)&&inGame()){ ctx.translate(W/2,GROUND); ctx.rotate(Math.sin(t*0.9)*0.028); ctx.translate(-W/2,-GROUND); }
    var sk=ctx.createLinearGradient(0,0,0,Hw); sk.addColorStop(0,pal.sky1); sk.addColorStop(1,pal.sky2);
    ctx.fillStyle=sk; ctx.fillRect(-60,-60,W+120,Hw+120);
    if(world===2) cyberBack(pal); else if(world===3) vampBack(pal); else if(WB[world]) WB[world].back(pal);
    if(world===1){
    ctx.fillStyle=pal.sun; ctx.beginPath(); ctx.arc(W-80,70,30,0,7); ctx.fill();
    ctx.fillStyle='rgba(255,255,255,.9)';
    clouds.forEach(function(c){ ctx.beginPath(); ctx.ellipse(c.x,c.y,38*c.s,14*c.s,0,0,7); ctx.ellipse(c.x+20*c.s,c.y-8*c.s,24*c.s,14*c.s,0,0,7); ctx.fill(); });
    ctx.fillStyle=pal.hill; ctx.beginPath(); ctx.moveTo(-20,GROUND);
    for(var x=-20;x<=W+20;x+=20) ctx.lineTo(x,GROUND-40-Math.sin((x+dist*0.15)/90)*22-Math.sin((x+dist*0.15)/37)*6);
    ctx.lineTo(W+20,GROUND); ctx.fill();
    ctx.fillStyle=pal.grass; ctx.fillRect(-20,GROUND,W+40,14);
    ctx.fillStyle=pal.dirt; ctx.fillRect(-20,GROUND+14,W+40,Hw-GROUND+30);
    ctx.fillStyle=pal.dirt2;
    for(var k=0;k<W+60;k+=60){ var gx=k-(dist%60); ctx.fillRect(gx,GROUND+30,24,5); }
    } else if(world===2) cyberGround(pal); else if(world===3) vampGround(pal); else WB[world].ground(pal);
    obs.forEach(function(o,i){
      curObsK=o.k;
      if(o.k==='gap'){ drawGapPit(o); return; }
      if(o.k==='tramp'){ drawTramp(o); return; }
      if(o.k==='drop'){ BDOWN=o.sp==='icicle'||(o.fall&&o.fy>o.r); drawProj(o); BDOWN=false; return; }
      if(o.fake){ ctx.save(); ctx.globalAlpha=0.62+0.3*Math.sin(t*10+i); }
      if(o.k==='flame') flame(o.x+o.w/2,o.w,o.h,i);
      else if(o.k==='flames'){ flame(o.x+o.w*.27,o.w*.46,o.h,i); flame(o.x+o.w*.73,o.w*.46,o.h*.9,i+2); }
      else if(o.k==='big') flame(o.x+o.w/2,o.w,o.h,i);
      else if(o.k==='triple'){ flame(o.x+o.w*.17,o.w*.34,o.h,i); flame(o.x+o.w*.5,o.w*.34,o.h*.9,i+1); flame(o.x+o.w*.83,o.w*.34,o.h,i+2); }
      else if(o.k==='tires'){ tire(o.x,52,-dist/26); tire(o.x+48,52,-dist/26+1); }
      else if(o.k==='proj') drawProj(o);
      else tire(o.x,o.w,-dist/(o.w/2));
      if(o.fake) ctx.restore();
    });
    pows.forEach(powBanana);
    if(boss&&boss.final){ var cx=Math.max(W-60,boss.x+130); woman(cx,0,false); cage(cx,boss.phase==='dying'?1:0); }
    if(rescue){
      var rp=rescue.phase, kissing=rp==='kiss'||state==='win', carried=rp==='seize'||rp==='carry'||rp==='gone';
      ctx.save(); if(carried) ctx.translate(0,-rescue.lift);
      woman(rescue.wx,carried?(rp==='carry'?-0.5+Math.sin(t*14)*0.12:0):(kissing?-0.12:0),kissing);
      ctx.restore();
      cage(rescue.wx,rescue.open);
      if(rp==='grab'||carried){ gorilla({throwT:rp==='grab'?0:1},rescue.gx,GROUND-((rp==='grab'||rp==='carry')?Math.abs(Math.sin(t*12))*4:0),false); }
    }
    if(boss) drawBoss(boss);
    bans.forEach(function(b){
      if(b.sk==='laser'){
        var lg=ctx.createLinearGradient(b.x-b.len,0,b.x,0); lg.addColorStop(0,'rgba(255,60,60,0)'); lg.addColorStop(1,'rgba(255,90,90,.95)');
        ctx.save(); ctx.lineCap='round'; ctx.strokeStyle=lg; ctx.lineWidth=14; ctx.beginPath(); ctx.moveTo(b.x-b.len,b.y); ctx.lineTo(b.x,b.y); ctx.stroke();
        ctx.strokeStyle='#fff'; ctx.lineWidth=5; ctx.beginPath(); ctx.moveTo(b.x-b.len*0.8,b.y); ctx.lineTo(b.x,b.y); ctx.stroke(); ctx.restore();
      } else if(b.sk==='wave'){
        ctx.save(); ctx.lineCap='round';
        for(i=0;i<3;i++){ ctx.strokeStyle=i===0?'#ffffff':'rgba(143,211,255,'+(0.9-i*0.25)+')'; ctx.lineWidth=7-i*1.5; ctx.beginPath(); ctx.arc(b.x-26-i*16,b.y,34+i*14,-0.95,0.95); ctx.stroke(); }
        ctx.restore();
      } else if(b.sk==='ball'){
        glow(b.x,b.y,30,0.35); ctx.fillStyle='#26262e'; ctx.beginPath(); ctx.arc(b.x,b.y,b.r,0,7); ctx.fill();
        ctx.fillStyle='rgba(255,255,255,.35)'; ctx.beginPath(); ctx.arc(b.x-6,b.y-6,5,0,7); ctx.fill();
        ctx.fillStyle='#ff9a2e'; ctx.beginPath(); ctx.arc(b.x-b.r-6,b.y+Math.sin(t*40)*3,4+Math.random()*2,0,7); ctx.fill();
      } else if(b.sk==='star'){
        ctx.save(); ctx.translate(b.x,b.y); ctx.rotate(t*22); ctx.fillStyle='#2a2d3a'; ctx.strokeStyle='#cfd6e6'; ctx.lineWidth=1.5; ctx.beginPath();
        for(i=0;i<8;i++){ var sa=i*Math.PI/4, sr=i%2?4:12; ctx.lineTo(Math.cos(sa)*sr,Math.sin(sa)*sr); }
        ctx.closePath(); ctx.fill(); ctx.stroke(); ctx.restore();
      } else if(b.big){ glow(b.x,b.y,34+34*b.c,0.55); banana(b.x,b.y,t*14,1+1.6*b.c,true,shotSel); }
      else { if(b.gold||shotSel) glow(b.x,b.y,18,0.5); banana(b.x,b.y,t*18,1,b.gold,shotSel); }
    });
    if(power>0&&inGame()){
      glow(px,p.y-30,46+4*Math.sin(t*8),0.38);
      for(i=0;i<3;i++){ var a=t*3+i*2.1; sparkle(px+Math.cos(a)*34,p.y-32+Math.sin(a)*30,3+Math.sin(t*9+i)*1.5); }
    }
    drawTrail();
    if(giantT>0||gs>1.01) glow(px,p.y-45*gs,60+4*Math.sin(t*10)+20*(gs-1),0.4);
    ctx.save();
    if(gs>1.001){ ctx.translate(px,p.y); ctx.scale(gs,gs); ctx.translate(-px,-p.y); }
    if(giantT>0&&giantT<1.5&&Math.floor(t*10)%2) ctx.globalAlpha=0.55;
    if(danceT>0||(UNL.dance&&state==='win')){
      var dph=danceT>0?(1-danceT/1.3):(t%1.3)/1.3, hop=Math.abs(Math.sin(dph*Math.PI*2))*16;
      ctx.translate(px,p.y-30-hop); ctx.rotate(dph*Math.PI*2); ctx.translate(-px,-(p.y-30));
    }
    drawBack(); peter();
    ctx.restore();
    if(spShieldT>0&&inGame()&&!(spShieldT<1.5&&Math.floor(t*10)%2)){
      ctx.save(); ctx.strokeStyle='rgba(143,211,255,.9)'; ctx.fillStyle='rgba(143,211,255,.18)'; ctx.lineWidth=3;
      ctx.beginPath(); ctx.arc(px,p.y-30*gs,44*gs,0,7); ctx.fill(); ctx.stroke(); ctx.restore();
    }
    if(charging&&chargeT>0.12){
      var c=chargeLvl(), bx0=px+34*gs, by0=p.y-40*gs, hy=p.y-88*gs;
      glow(bx0,by0,18+34*c,0.5+0.3*c);
      banana(bx0,by0,t*10,0.6+1.4*c,true);
      for(i=0;i<5;i++){ var a2=t*6+i*1.26, rad=20+22*c; ctx.fillStyle=(i%2)?'#fff':'#ffd23f'; ctx.beginPath(); ctx.arc(bx0+Math.cos(a2)*rad,by0+Math.sin(a2)*rad,2.5,0,7); ctx.fill(); }
      ctx.fillStyle='#26200f'; ctx.fillRect(px-32,hy,64,9);
      ctx.fillStyle=c>=1?(Math.floor(t*12)%2?'#fff':'#ffd23f'):'#ff9a2e'; ctx.fillRect(px-30,hy+2,60*c,5);
      if(c>=1) txt('MEGA!',px,hy-8,16,'#ffd23f');
    }
    hearts.forEach(function(h){ ctx.globalAlpha=Math.min(1,h.life); heart(h.x,h.y,h.s,'#e0235a'); ctx.globalAlpha=1; });
    parts.forEach(function(q){ ctx.globalAlpha=Math.min(1,q.life*2.2); ctx.fillStyle=q.col; ctx.beginPath(); ctx.arc(q.x,q.y,q.s,0,7); ctx.fill(); });
    ctx.globalAlpha=1;
    ctx.restore();

    if(lvlNum()>CYC&&inGame()){ ctx.fillStyle='rgba(120,0,30,'+(boss?0.12:0.07)+')'; ctx.fillRect(0,0,W,Hw); }
    if(diff===DIFFS[2]&&inGame()){ ctx.fillStyle='rgba(200,30,0,'+(boss?0.14:0.08)+')'; ctx.fillRect(0,0,W,Hw); }

    worldOverlay();
    pops.forEach(function(o){ ctx.globalAlpha=Math.min(1,o.life/o.max*2); txt(o.txt,o.x,o.y,o.size,o.col); ctx.globalAlpha=1; });

    var cy=Hw*0.30;
    if(isMenuState()){
      var ln0=music.line();
      if(ln0&&state==='main'){ ctx.globalAlpha=Math.min(1,Math.max(0,(3.6-ln0.age)/0.6)); txt(ln0.text,W/2,GROUND+46,ln0.hook?27:17,ln0.hook?'#ffd23f':'#fff'); ctx.globalAlpha=1; }
      drawMenus(); return;
    }
    drawHud(); worldWarn();
    if(state==='play'){
      if(boss&&boss.age<2.6){
        var ba=Math.min(1,(2.6-boss.age)*2), bx1=W*0.38, by1=Hw*0.36;
        ctx.globalAlpha=ba;
        txt(boss.n===NLV?'Final Boss!':'Level '+boss.n+': Boss!',bx1,by1,28);
        txt(boss.L.bname+(boss.wut?' · WUT':''),bx1,by1+24,17,boss.wut?'#ff7a5a':'#ffd23f');
        if(boss.final) txt('Rette die Frau!',bx1,by1+46,16,'#ffd23f');
        else if(boss.n===1) txt(touch?'Rechts tippen: Banane · halten: Ladeangriff':'A: Banane · A halten: Ladeangriff',bx1,by1+46,14,'#fff');
        ctx.globalAlpha=1;
      } else if(!boss){
        if(lvlBanner>0){
          ctx.globalAlpha=Math.min(1,lvlBanner*1.5);
          if(worldBanner>0) txt('Welt '+world+' · '+WNAMES[world-1],W/2,cy-30,18,'#8fd3ff');
          txt('Level '+lvlNum()+' · '+lvName(lvlNum()),W/2,cy,26);
          if(WX[world]&&lvlNum()===1) txt(WX[world].tip,W/2,cy+24,13,'#8fd3ff');
          if(lvlNum()>CYC) txt('Wut-Modus: Die Bosse sind stärker!',W/2,cy+22,15,'#ff7a5a');
          ctx.globalAlpha=1;
        }
        if(hintT>0){
          ctx.globalAlpha=Math.min(1,hintT)*0.95;
          var hy0=cy+50;
          txt((touch?'Links tippen: springen':'Leertaste: springen')+(diff===DIFFS[0]?' (2x = Doppelsprung)':'')+' · '+(touch?'Rechts tippen: Banane':'A: Banane'),W/2,hy0,14,'#fff');
          txt('5 Power-Bananen = Riesen-Peter'+(specAvail()?' · '+(touch?'Knopf unten links':'S')+': '+SPEC[costume].n:''),W/2,hy0+20,14,'#ffd23f');
          ctx.globalAlpha=1;
        }
      }
    } else if(state==='rescue'){
      var rpz=rescue.phase;
      if(rpz==='kiss'){ txt('Peter hat die Frau gerettet!',W/2,cy,38); txt('Dafür gibt es einen Kuss!',W/2,cy+40,26,'#ffd23f'); }
      else if(rpz==='grab') txt('Doch da kommt der Gorilla zurück!',W/2,cy,34,'#ff9a5a');
      else if(rpz==='seize') txt('Der Gorilla packt die Frau!',W/2,cy,38,'#ff9a5a');
      else if(rpz==='carry'){ txt('Hilfe, Peter!',W/2,cy,42); txt('Der Gorilla entführt sie!',W/2,cy+38,24,'#ff9a5a'); }
      else if(rpz==='gone'){ txt('Entführt!',W/2,cy,46,'#ff7a5a'); txt('Hol sie dir zurück: Level 11 bis 20',W/2,cy+40,24,'#ffd23f'); txt('Die Bosse sind jetzt wütend!',W/2,cy+70,22,'#ff7a5a'); }
      else if(rpz==='nextworld'){ txt('Welt '+world+' geschafft!',W/2,cy,44,'#ffd23f'); txt('Weiter geht\'s in Welt '+(world+1)+': '+WNAMES[world],W/2,cy+40,26); txt('Bananen bisher: +'+runBan,W/2,cy+70,20,'#fff07a'); }
      else txt('Der Gorilla ist besiegt!',W/2,cy,38);
    } else if(state==='dead'){
      txt('Aua! Peter ist gestolpert.',W/2,cy-6,34);
      txt('Level '+lvlNum()+' · '+diff.name+' · Punkte: '+score.toLocaleString('de-DE')+(score>=bests[di]&&score>0?'  (Rekord!)':''),W/2,cy+20,17,'#ffd23f');
      txt('Bananen: +'+runBan+'  (Gesamt '+fmt(bananas)+')',W/2,cy+40,15,'#fff07a');
      for(i=0;i<almost.length;i++){ var pz=1+0.04*Math.sin(t*6); txt(almost[i],W/2,cy+66+i*22,18*pz,'#ff9a5a'); }
      var E=endRects(); btn(E[0],touch?'Nochmal':'Nochmal (Leertaste)','','#e6a800',false); btn(E[1],touch?'Hauptmenü':'Hauptmenü (D)','','#5fbf4a',false);
    } else if(state==='win'){
      txt('Gewonnen!',W/2,cy,46);
      txt(diff.name+': Alle Welten geschafft, die Frau ist endgültig gerettet!',W/2,cy+36,20,'#ffd23f');
      txt('Bananen: +'+runBan+'  (Gesamt '+fmt(bananas)+')',W/2,cy+64,20,'#fff07a');
      var E2=endRects(); btn(E2[0],touch?'Nochmal':'Nochmal (Leertaste)','','#e6a800',false); btn(E2[1],touch?'Hauptmenü':'Hauptmenü (D)','','#5fbf4a',false);
    }
    if(state==='pause') drawPause();
  }

  /* ===== Menüsystem: Hauptmenü, Welt-Auswahl, Schwierigkeit, Shop, Einstellungen, Pause ===== */
  var SL_X0=280, SL_X1=470;
  function frame(){ return {x:(W-640)/2,y:(Hw-400)/2}; }
  function isMenuState(){ return state==='missions'||state==='code'||state==='main'||state==='world'||state==='menu'||state==='shop'||state==='settings'; }
  function inGame(){ return state==='play'||state==='dead'||state==='win'||state==='rescue'||state==='pause'; }
  function menuMsgShow(m){ menuMsg=m; menuMsgT=2.4; }
  function go(st,id){ state=st; var it=uiItems(), i; sel=0; if(id) for(i=0;i<it.length;i++) if(it[i].id===id) sel=i; }
  function toMain(){ reset(); go('main'); }
  function pauseGame(){ if(state!=='play') return; charging=false; chargeT=0; chargeId=null; go('pause','resume'); }
  function pauseRect(){ return {x:W-44,y:10,w:34,h:34}; }
  function uiItems(){
    var it=[], i, y;
    if(state==='main'){
      it.push({id:'play',r:{x:170,y:122,w:300,h:48}},{id:'missions',r:{x:170,y:176,w:300,h:48}},{id:'shop',r:{x:170,y:230,w:300,h:48}},{id:'settings',r:{x:170,y:284,w:300,h:48}},{id:'master',r:{x:240,y:342,w:160,h:30}});
    } else if(state==='missions'){
      it.push({id:'mtA',r:{x:236,y:12,w:120,h:34}},{id:'mtW',r:{x:364,y:12,w:120,h:34}});
      if(misTab===0) it.push({id:'mprev',r:{x:400,y:346,w:46,h:38}},{id:'mnext',r:{x:574,y:346,w:46,h:38}});
      it.push({id:'back',r:{x:20,y:346,w:140,h:38}});
    } else if(state==='code'){
      var KS=['k1','k2','k3','k4','k5','k6','k7','k8','k9','kdel','k0','kok'];
      for(i=0;i<12;i++) it.push({id:KS[i],r:{x:207+(i%3)*78,y:108+Math.floor(i/3)*52,w:70,h:44}});
      it.push({id:'back',r:{x:250,y:344,w:140,h:40}});
    } else if(state==='world'){
      for(i=0;i<3;i++){ var wi2=worldPage*3+i; if(wi2<WORLDS.length) it.push({id:'w'+(wi2+1),r:{x:20+i*205,y:84,w:190,h:210}}); }
      it.push({id:'wprev',r:{x:20,y:322,w:64,h:44}},{id:'back',r:{x:250,y:322,w:140,h:44}},{id:'wnext',r:{x:556,y:322,w:64,h:44}});
    } else if(state==='menu'){
      for(i=0;i<3;i++) it.push({id:'d'+i,r:{x:155,y:104+i*56,w:330,h:48}});
      it.push({id:'back',r:{x:250,y:296,w:140,h:44}});
    } else if(state==='shop'){
      it.push({id:'tabC',r:{x:160,y:14,w:150,h:40}},{id:'tabP',r:{x:320,y:14,w:150,h:40}});
      if(shopTab===1) it.push({id:'pu_j',r:{x:40,y:62,w:270,h:104}},{id:'pu_d',r:{x:330,y:62,w:270,h:104}},{id:'pu_v',r:{x:40,y:174,w:270,h:104}},{id:'pu_s',r:{x:330,y:174,w:270,h:104}},{id:'prev',r:{x:330,y:284,w:46,h:30}},{id:'next',r:{x:554,y:284,w:46,h:30}});
      if(shopTab===0) it.push({id:'prev',r:{x:50,y:150,w:64,h:80}},{id:'next',r:{x:526,y:150,w:64,h:80}},{id:'var',r:{x:420,y:118,w:100,h:34}},{id:'buy',r:{x:200,y:292,w:240,h:46}});
      it.push({id:'back',r:{x:20,y:346,w:130,h:40}});
    } else if(state==='settings'){
      y=54;
      var SROWS=['music','vol','voice']; if(music.voiceMode()===1&&music.voiceCount()>1) SROWS.push('voicesel'); SROWS.push('cos','trail','shot');
      var sst=SROWS.length>7?36:40;
      for(i=0;i<SROWS.length;i++){ it.push({id:SROWS[i],r:{x:90,y:y,w:460,h:sst-6}}); y+=sst; }
      it.push({id:'back',r:{x:250,y:342,w:140,h:38}});
    } else if(state==='pause'){
      it.push({id:'resume',r:{x:190,y:150,w:260,h:52}},{id:'tomain',r:{x:190,y:216,w:260,h:52}});
    }
    return it;
  }
  function uiHit(g){
    var F=frame(), it=uiItems(), q={x:g.x-F.x,y:g.y-F.y}, i;
    for(i=0;i<it.length;i++) if(inR(it[i].r,q)) return {i:i,it:it[i]};
    return null;
  }
  function setVolFromX(x){ var v=(x-SL_X0)/(SL_X1-SL_X0); music.setVol(Math.round(Math.max(0,Math.min(1,v))*20)/20); }
  function platPrice(ci){ return ci===0?100:PRICE[ci]*10; }
  function spPrice(ci,L){ var P=Math.max(20,PRICE[ci]); return Math.round(P*[1,1.5,2][L]/5)*5; }
  function buyPU(id){
    var price, nm, ci=shopIdx;
    if(id==='pu_j'){ if(PU.j>=3){ menuMsgShow('Sprungkraft ist auf Maximum'); return; } price=PUP_J[PU.j]; nm='Sprungkraft Stufe '+(PU.j+1); }
    else if(id==='pu_d'){ if(PU.d>=3){ menuMsgShow('Schaden ist auf Maximum'); return; } price=PUP_D[PU.d]; nm='Bananen-Schaden Stufe '+(PU.d+1); }
    else if(id==='pu_v'){ if(PU.v){ menuMsgShow('Bananen-Wert ist schon aktiv'); return; } price=PUP_V; nm='Bananen-Wert x2'; }
    else { if(!owned[ci]){ menuMsgShow('Schalte zuerst das Kostüm '+COSTUMES[ci]+' frei'); return; } if(PU.s[ci]>=3){ menuMsgShow(SPEC[ci].n+' ist auf Maximum'); return; } price=spPrice(ci,PU.s[ci]); nm=SPEC[ci].n+' Stufe '+(PU.s[ci]+1); }
    if(bananas<price){ menuMsgShow('Dir fehlen noch '+(price-bananas)+' Bananen'); return; }
    bananas-=price;
    if(id==='pu_j') PU.j++; else if(id==='pu_d') PU.d++; else if(id==='pu_v') PU.v=1; else PU.s[ci]++;
    saveEco(); menuMsgShow('Gekauft: '+nm);
  }
  function shopBuy(){
    var ci=shopIdx;
    if(!shopPlat){
      if(owned[ci]){ setCostume(ci); platOn[ci]=0; saveEco(); menuMsgShow(COSTUMES[ci]+' ausgerüstet'); }
      else if(bananas>=PRICE[ci]){ bananas-=PRICE[ci]; owned[ci]=1; platOn[ci]=0; saveEco(); setCostume(ci); menuMsgShow('Gekauft! '+COSTUMES[ci]+' ist ausgerüstet'); }
      else menuMsgShow('Dir fehlen noch '+(PRICE[ci]-bananas)+' Bananen');
      return;
    }
    var pr=platPrice(ci);
    if(plat[ci]){ setCostume(ci); platOn[ci]=1; saveEco(); menuMsgShow('Platin-'+COSTUMES[ci]+' ausgerüstet'); }
    else if(!owned[ci]) menuMsgShow('Kaufe zuerst das Kostüm '+COSTUMES[ci]);
    else if(bananas>=pr){ bananas-=pr; plat[ci]=1; platOn[ci]=1; saveEco(); setCostume(ci); menuMsgShow('Gekauft! Platin-'+COSTUMES[ci]+' ist ausgerüstet'); }
    else menuMsgShow('Dir fehlen noch '+(pr-bananas)+' Bananen');
  }
  /* ===== Mastercode: einmal = alles freischalten, nochmal = alles auf Null ===== */
  function masterOn(){ try{ return localStorage.getItem('peterMaster')==='1'; }catch(e){ return false; } }
  function applyMaster(){
    var on=!masterOn(), i;
    if(on){
      for(i=0;i<8;i++){ owned[i]=1; plat[i]=1; }
      PU={j:3,d:3,v:1,s:[3,3,3,3,3,3,3,3]}; UNL={trail:[1,1,1],shot:[1,1],dance:1}; PROG.u=[WNAMES.length,WNAMES.length,WNAMES.length]; saveProg();
      menuMsgShow('Mastercode aktiv: alles freigeschaltet!');
    } else {
      for(i=0;i<8;i++){ owned[i]=i===0?1:0; plat[i]=0; platOn[i]=0; }
      PU={j:0,d:0,v:0,s:[0,0,0,0,0,0,0,0]}; bananas=0; costume=0; shopIdx=0; shopPlat=0;
      UNL={trail:[0,0,0],shot:[0,0],dance:0}; trailSel=0; shotSel=0; MS={prog:{},done:{}}; DS=null; ensureDaily(); PROG={u:[1,1,1],c:{}}; saveProg(); setWorld(1);
      try{ localStorage.setItem('peterCostume2',0); }catch(e){}
      menuMsgShow('Mastercode aus: alles auf Null zurückgesetzt');
    }
    try{ localStorage.setItem('peterMaster',on?'1':'0'); }catch(e){}
    saveEco(); saveMis();
  }
  function codeKey(k){
    if(k==='del'){ codeIn=codeIn.slice(0,-1); return; }
    if(k==='ok'){
      if(codeIn===MASTER) applyMaster();
      else if(codeIn) menuMsgShow('Falscher Code');
      codeIn=''; return;
    }
    if(codeIn.length<8) codeIn+=k;
  }
  function uiActivate(id,g){
    var F=frame();
    switch(id){
      case 'play': goWorld(); break;
      case 'wprev': case 'wnext': worldPage=(worldPage+(id==='wnext'?1:-1)+Math.ceil(WORLDS.length/3))%Math.ceil(WORLDS.length/3); go('world',id); break;
      case 'shop': shopTab=0; shopIdx=costume; go('shop','buy'); break;
      case 'settings': go('settings','music'); break;
      case 'missions': misPage=0; go('missions','back'); break;
      case 'mtA': misTab=0; break;
      case 'mtW': misTab=1; break;
      case 'mprev': misPage=Math.max(0,misPage-1); break;
      case 'mnext': misPage=Math.min(misPages()-1,misPage+1); break;
      case 'trail': cycleTrail(1); break;
      case 'shot': cycleShot(1); break;
      case 'master': codeIn=''; go('code','k1'); break;
      case 'kdel': codeKey('del'); break;
      case 'kok': codeKey('ok'); break;
      case 'd0': case 'd1': case 'd2': tryStart(+id.charAt(1)); break;
      case 'tabC': shopTab=0; break;
      case 'tabP': shopTab=1; break;
      case 'prev': shopIdx=(shopIdx+7)%8; break;
      case 'next': shopIdx=(shopIdx+1)%8; break;
      case 'var': shopPlat=1-shopPlat; break;
      case 'buy': shopBuy(); break;
      case 'pu_j': case 'pu_d': case 'pu_v': case 'pu_s': buyPU(id); break;
      case 'music': toggleMusic(); break;
      case 'vol': if(g){ var gx=g.x-F.x; if(gx>=SL_X0-18&&gx<=SL_X1+18){ dragVol=true; setVolFromX(gx); } } break;
      case 'voice': toggleVoice(); break;
      case 'voicesel': nextVoice(); break;
      case 'cos': cycleCos(1); break;
      case 'resume': state='play'; break;
      case 'tomain': toMain(); break;
      default: if(/^k\d$/.test(id)) codeKey(id.charAt(1)); else if(/^w\d+$/.test(id)){ var wsel=+id.slice(1); if(!worldOpen(wsel)) menuMsgShow('Gesperrt: Schaffe zuerst Welt '+(wsel-1)); else { setWorld(wsel); var dd=isUnl(wsel,di)?di:(isUnl(wsel,0)?0:isUnl(wsel,1)?1:2); go('menu','d'+dd); } } break;
      case 'back': if(state==='menu') goWorld(); else go('main'); break;
    }
    var n=uiItems().length; if(sel>=n) sel=0;
  }
  function uiBack(){
    if(state==='play') pauseGame();
    else if(state==='pause') state='play';
    else if(state==='menu') goWorld();
    else if(state==='world'||state==='shop'||state==='settings'||state==='code'||state==='missions') go('main');
    else if(state==='dead'||state==='win') toMain();
  }
  function uiAdjust(id,d){
    if(state==='shop'){ if(shopTab===0) shopIdx=(shopIdx+d+8)%8; return; }
    if(state==='world'){
      var NPg=Math.ceil(WORLDS.length/3);
      if(/^w\d+$/.test(id)){ var nw=Math.max(1,Math.min(WORLDS.length,+id.slice(1)+d)); worldPage=Math.floor((nw-1)/3); go('world','w'+nw); }
      else { worldPage=(worldPage+d+NPg)%NPg; go('world',id); }
      return;
    }
    if(state==='missions'){ if(id==='mtA'||id==='mtW'){ misTab=d>0?1:0; go('missions',misTab?'mtW':'mtA'); return; } misPage=Math.max(0,Math.min(misPages()-1,misPage+d)); return; }
    if(state!=='settings') return;
    if(id==='trail'){ cycleTrail(d); return; }
    if(id==='shot'){ cycleShot(d); return; }
    if(id==='vol') music.setVol(Math.round((music.getVol()+d*0.05)*20)/20);
    else if(id==='cos') cycleCos(d);
    else if(id==='music') toggleMusic();
    else if(id==='voice') toggleVoice();
    else if(id==='voicesel') nextVoice();
  }
  function uiKey(k){
    var it=uiItems(), n=it.length;
    if(sel>=n) sel=0;
    if(k==='ArrowDown') sel=(sel+1)%n;
    else if(k==='ArrowUp') sel=(sel+n-1)%n;
    else if(k==='ArrowLeft'||k==='ArrowRight') uiAdjust(it[sel].id,k==='ArrowLeft'?-1:1);
  }

  /* Zeichnen: Bausteine */
  function plate(R,col,on){
    ctx.save();
    rr(R.x,R.y+4,R.w,R.h,11); ctx.fillStyle='#26200f'; ctx.fill();
    rr(R.x,R.y,R.w,R.h,11); ctx.fillStyle=col; ctx.fill(); ctx.lineWidth=on?4:2.5; ctx.strokeStyle=on?'#fff':'#26200f'; ctx.stroke();
    ctx.restore();
  }
  function tri(x,y,dir,size,col){ ctx.fillStyle=col||'#fff'; ctx.beginPath(); ctx.moveTo(x+dir*size,y); ctx.lineTo(x-dir*size*0.7,y-size); ctx.lineTo(x-dir*size*0.7,y+size); ctx.closePath(); ctx.fill(); }
  function badge(xr,y,n){
    var str=fmt(n); ctx.font='700 22px "Fredoka","Trebuchet MS",sans-serif';
    var w=ctx.measureText(str).width;
    banana(xr-w-22,y-8,0.3,1.1,true); txt(str,xr,y,22,'#ffd23f','right');
  }
  function drawPauseBtn(){
    var R=pauseRect(); plate(R,'#4a7de0',false);
    ctx.fillStyle='#fff'; ctx.fillRect(R.x+10,R.y+9,5,16); ctx.fillRect(R.x+19,R.y+9,5,16);
  }
  function previewPeter(cx,gy,sc,c,pl){
    var sPx=px, sP=p, sC=costume, sA=shootAnim; previewPl=pl?1:0;
    px=0; p={y:0,vy:0,on:true,j:0}; costume=c; shootAnim=0;
    ctx.save(); ctx.translate(cx,gy); ctx.scale(sc,sc);
    drawBack(); peter();
    ctx.restore();
    px=sPx; p=sP; costume=sC; shootAnim=sA; previewPl=-1;
  }
  function drawMenus(){
    var F=frame(), it=uiItems(), RR={}, i, cur=it[sel]?it[sel].id:'';
    it.forEach(function(q){ RR[q.id]=q.r; });
    ctx.fillStyle=(state==='shop'||state==='settings'||state==='code'||state==='missions')?'rgba(10,20,15,0.66)':'rgba(10,20,15,0.28)'; ctx.fillRect(-20,-20,W+40,Hw+40);
    ctx.save(); ctx.translate(F.x,F.y);
    if(state==='main'){
      logoEmblem(166,66+Math.sin(t*2)*2,44);
      txt('PETERS',250,46,24,'#ffd23f','left');
      txt('JUNGLE WAR',250,88,42,'#fff','left');
      txt('Lass die Affen aus dem Zoo!',250,112,14,'#ffd23f','left');
      btn(RR.play,'Spielen','','#5fbf4a',cur==='play');
      var oc=openCount(), dOpen=0; dailyList().forEach(function(m){ if(!DS.done[m.id]) dOpen++; });
      btn(RR.missions,'Missionen',oc+' offen · heute noch '+dOpen+' von 3','#d6402a',cur==='missions');
      if(dOpen>0){ ctx.fillStyle='#ffd23f'; ctx.strokeStyle='#26200f'; ctx.lineWidth=2.5; ctx.beginPath(); ctx.arc(RR.missions.x+RR.missions.w-6,RR.missions.y+6,11,0,7); ctx.fill(); ctx.stroke(); txt(''+dOpen,RR.missions.x+RR.missions.w-6,RR.missions.y+11,13,'#26200f'); }
      btn(RR.shop,'Shop','Kostüme & Power-Ups','#e6a800',cur==='shop');
      btn(RR.settings,'Einstellungen','Musik · Kostüm · Spuren','#4a7de0',cur==='settings');
      plate(RR.master,'#7a4ab8',cur==='master'); txt('Mastercode',RR.master.x+RR.master.w/2,RR.master.y+21,15,'#fff');
      badge(620,36,bananas);
      txt(COPY,320,392,11,'rgba(255,255,255,.85)');
    } else if(state==='world'){
      txt('Wähle deine Welt',320,50,30);
      var NWP=Math.ceil(WORLDS.length/3);
      for(var wq=0;wq<3;wq++){
        var wi=worldPage*3+wq; if(wi>=WORLDS.length) break;
        var wid='w'+(wi+1), R=RR[wid], cx3=R.x+R.w/2, cy3=R.y+112;
        var wop=worldOpen(wi+1);
        btn(R,'Welt '+(wi+1),WNAMES[wi],wop?WCOL[wi]:'#55556a',cur===wid);
        if(!wop){ lockIcon(cx3,cy3,34,'rgba(255,255,255,.85)'); txt('Gesperrt',cx3,R.y+164,16,'#fff'); txt('Schaffe Welt '+wi,cx3,R.y+186,13,'#ffd23f'); continue; }
        if(wi===0) banana(cx3,cy3+Math.sin(t*3)*3,0.3,2.8,true);
        else if(wi===1){ bG(cx3,cy3,56,'#00e5ff',0.5); drawBall(cx3,cy3,34,'saw',t*2); }
        else if(wi===2){ bG(cx3,cy3,56,'#ff8a1a',0.4); drawBall(cx3,cy3+Math.sin(t*3)*3,34,'pumpkin',Math.sin(t)*0.3); }
        else { var wxx=WX[wi+1]; bG(cx3,cy3,56,wxx.col,0.45); drawBall(cx3,cy3+Math.sin(t*3)*3,32,wxx.roll,wxx.roll==='toycar'?t*4:Math.sin(t)*0.6); }
        txt('20 Level · 10 Bosse',cx3,R.y+160,14,'#fff');
        for(var dq=0;dq<3;dq++){ var pxq=cx3-48+dq*48, pyq=R.y+186, cl=isClr(wi+1,dq), un=isUnl(wi+1,dq);
          bC(pxq,pyq,13,cl?'#3ab04a':un?'rgba(255,255,255,.25)':'rgba(0,0,0,.35)'); ctx.lineWidth=2; ctx.strokeStyle=cl?'#fff':'rgba(255,255,255,.6)'; ctx.beginPath(); ctx.arc(pxq,pyq,13,0,7); ctx.stroke();
          if(cl) bL('#fff',3,[pxq-6,pyq,pxq-1,pyq+5,pxq+7,pyq-5]); else if(!un) lockIcon(pxq,pyq+1,11,'rgba(255,255,255,.7)'); else txt(['E','M','J'][dq],pxq,pyq+5,13,'#fff'); }
      }
      for(var wd2=0;wd2<NWP;wd2++) bC(320-(NWP-1)*9+wd2*18,308,wd2===worldPage?5:3.5,wd2===worldPage?'#ffd23f':'rgba(255,255,255,.55)');
      plate(RR.wprev,'#4a7de0',cur==='wprev'); tri(RR.wprev.x+RR.wprev.w/2-3,RR.wprev.y+RR.wprev.h/2,-1,10);
      plate(RR.wnext,'#4a7de0',cur==='wnext'); tri(RR.wnext.x+RR.wnext.w/2+3,RR.wnext.y+RR.wnext.h/2,1,10);
      btn(RR.back,'Zurück','','#8a5a2b',cur==='back');
    } else if(state==='menu'){
            txt('Welt '+world+' · '+WNAMES[world-1],320,34,17,'#ffd23f');
      txt('Wähle deine Schwierigkeit',320,72,28);
      for(i=0;i<3;i++){
        var du=isUnl(world,i), dc=isClr(world,i);
        btn(RR['d'+i],DIFFS[i].name,du?DIFFS[i].desc:'Gesperrt – schaffe Welt '+(world-1)+' auf '+DIFFS[i].name,du?DIFFS[i].col:'#55556a',cur==='d'+i,dc?'✓ geschafft':(bests[i]>0?'Rekord '+fmt(bests[i]):''));
        if(!du) lockIcon(RR['d'+i].x+RR['d'+i].w-24,RR['d'+i].y+26,16,'#fff');
      }
      btn(RR.back,'Zurück','','#8a5a2b',cur==='back');
      txt(touch?'Tippe auf eine Stufe zum Starten':'Pfeiltasten + Enter, oder 1 · 2 · 3',320,380,16,'#fff');
    } else if(state==='shop'){
      txt('Shop',24,42,32,'#fff','left');
      plate(RR.tabC,shopTab===0?'#e6a800':'#6a5a3a',cur==='tabC'); txt('Kostüme',RR.tabC.x+RR.tabC.w/2,RR.tabC.y+27,19);
      plate(RR.tabP,shopTab===1?'#e6a800':'#6a5a3a',cur==='tabP'); txt('Power-Ups',RR.tabP.x+RR.tabP.w/2,RR.tabP.y+27,19);
      badge(620,42,bananas);
      if(shopTab===0){
        var ci=shopIdx, own=shopPlat?plat[ci]:owned[ci], eq=costume===ci&&owned[ci]&&((platOn[ci]&&plat[ci])?1:0)===shopPlat, pr=shopPlat?platPrice(ci):PRICE[ci];
        var locked=shopPlat&&!owned[ci];
        txt(COSTUMES[ci]+(shopPlat?' · Platin':''),320,84,30,shopPlat?'#dfe8f2':'#fff');
        txt((ci+1)+' / 8'+(own?'':'  ·  gesperrt'),320,106,14,own?'#9be05a':'#ffd23f');
        if(shopPlat){ var gl=ctx.createRadialGradient(320,190,10,320,190,90); gl.addColorStop(0,'rgba(230,240,255,.55)'); gl.addColorStop(1,'rgba(230,240,255,0)'); ctx.fillStyle=gl; ctx.beginPath(); ctx.arc(320,190,90,0,7); ctx.fill(); }
        ctx.fillStyle='rgba(0,0,0,.35)'; ctx.beginPath(); ctx.ellipse(320,270,72,12,0,0,7); ctx.fill();
        previewPeter(320,266,1.8,ci,shopPlat);
        plate(RR.prev,'#4a7de0',cur==='prev'); tri(RR.prev.x+RR.prev.w/2-4,RR.prev.y+RR.prev.h/2,-1,16);
        plate(RR.next,'#4a7de0',cur==='next'); tri(RR.next.x+RR.next.w/2+4,RR.next.y+RR.next.h/2,1,16);
        plate(RR.var,shopPlat?'#7d8896':'#9aa6b4',cur==='var'); txt(shopPlat?'Normal':'Platin',RR.var.x+RR.var.w/2,RR.var.y+24,17,'#fff');
        var lab=eq?'Ausgerüstet':(own?'Ausrüsten':'Kaufen'), col=eq?'#4a8a4a':(own?'#4a7de0':(locked?'#6a6f7a':(bananas>=pr?'#5fbf4a':'#a04a3a')));
        plate(RR.buy,col,cur==='buy');
        txt(lab,RR.buy.x+(own?RR.buy.w/2:20),RR.buy.y+RR.buy.h/2+7,21,'#fff',own?'center':'left');
        if(!own) priceTag(RR.buy,pr);
      } else {
        function puCard(id,title,sub,lv,max,desc,price,locked){
          var R=RR[id], maxed=lv>=max, col=maxed?'#3f7a3f':(locked?'#555a66':(price!==null&&bananas>=price?'#2f6aa8':'#5a4a3a'));
          plate(R,col,cur===id);
          txt(title,R.x+14,R.y+26,19,'#fff','left');
          txt(sub,R.x+R.w-14,R.y+26,13,'#ffd23f','right');
          for(var k=0;k<max;k++){ ctx.fillStyle=k<lv?'#ffd23f':'rgba(0,0,0,.35)'; ctx.strokeStyle='#26200f'; ctx.lineWidth=2; ctx.beginPath(); ctx.arc(R.x+22+k*22,R.y+48,8,0,7); ctx.fill(); ctx.stroke(); }
          txt(desc,R.x+14,R.y+68,13,'#fff','left');
          var PR={x:R.x,y:R.y+R.h-28,w:R.w,h:30};
          if(maxed) txt('Maximal',R.x+R.w-16,R.y+R.h-8,17,'#9be05a','right');
          else if(locked) txt('Kostüm freischalten',R.x+R.w-16,R.y+R.h-8,15,'#d0d4dc','right');
          else priceTag(PR,price);
        }
        puCard('pu_j','Sprungkraft','Stufe '+PU.j+'/3',PU.j,3,'+5% Sprungstärke pro Stufe',PU.j<3?PUP_J[PU.j]:null,false);
        puCard('pu_d','Bananen-Schaden','Stufe '+PU.d+'/3',PU.d,3,'+25% Schaden pro Stufe',PU.d<3?PUP_D[PU.d]:null,false);
        puCard('pu_v','Bananen-Wert','x2',PU.v,1,'1 Banane zählt als 2 im Shop',PU.v?null:PUP_V,false);
        var sc=shopIdx, sl=PU.s[sc];
        puCard('pu_s',SPEC[sc].n,'Stufe '+sl+'/3',sl,3,SPEC[sc].d,sl<3?spPrice(sc,sl):null,!owned[sc]);
        plate(RR.prev,'#4a7de0',cur==='prev'); tri(RR.prev.x+RR.prev.w/2-3,RR.prev.y+RR.prev.h/2,-1,10);
        plate(RR.next,'#4a7de0',cur==='next'); tri(RR.next.x+RR.next.w/2+3,RR.next.y+RR.next.h/2,1,10);
        txt('Spezial für: '+COSTUMES[sc],(RR.prev.x+RR.next.x+RR.next.w)/2,RR.prev.y+22,15,owned[sc]?'#fff':'#ffd23f');
      }
      btn(RR.back,'Zurück','','#8a5a2b',cur==='back');
    } else if(state==='missions'){
      drawMissions(RR,cur);
    } else if(state==='code'){
      txt('Mastercode',320,40,30);
      plate({x:207,y:54,w:226,h:44},'#10223a',false);
      var shown=''; for(i=0;i<codeIn.length;i++) shown+='● ';
      txt(shown||'Code eingeben',320,84,shown?22:16,shown?'#ffd23f':'rgba(255,255,255,.6)');
      it.forEach(function(q){
        if(q.id==='back') return;
        var lab=q.id==='kdel'?'⌫':q.id==='kok'?'OK':q.id.charAt(1), col=q.id==='kok'?'#5fbf4a':q.id==='kdel'?'#a04a3a':'#2f6aa8';
        plate(q.r,col,cur===q.id); txt(lab,q.r.x+q.r.w/2,q.r.y+q.r.h/2+8,22,'#fff');
      });
      btn(RR.back,'Zurück','','#8a5a2b',cur==='back');
      txt(masterOn()?'Status: aktiv':'Status: aus',600,40,14,masterOn()?'#9be05a':'#fff','right');
    } else if(state==='settings'){
      txt('Einstellungen',320,44,32);
      ['music','vol','voice','voicesel','cos','trail','shot'].forEach(function(id){
        var R=RR[id]; if(!R) return;
        var on=cur===id, cy2=R.y+R.h/2+7, cyl=R.y+R.h/2;
        plate(R,'#2f6aa8',on);
        if(id==='music'){ txt('Musik',R.x+18,cy2,20,'#fff','left'); txt(music.muted()?'Aus':'An',R.x+R.w-18,cy2,20,music.muted()?'#ff9a8a':'#9be05a','right'); }
        else if(id==='vol'){
          var vv=music.getVol();
          txt('Lautstärke',R.x+18,cy2,20,'#fff','left');
          rr(SL_X0,cyl-4,SL_X1-SL_X0,8,4); ctx.fillStyle='#10223a'; ctx.fill();
          if(vv>0.06){ rr(SL_X0,cyl-4,(SL_X1-SL_X0)*vv,8,4); ctx.fillStyle='#ffd23f'; ctx.fill(); }
          ctx.fillStyle='#fff'; ctx.strokeStyle='#26200f'; ctx.lineWidth=3; ctx.beginPath(); ctx.arc(SL_X0+(SL_X1-SL_X0)*vv,cyl,10,0,7); ctx.fill(); ctx.stroke();
          txt(Math.round(vv*100)+' %',R.x+R.w-18,cy2,18,'#fff','right');
        }
        else if(id==='voice'){ txt('Gesang',R.x+18,cy2,20,'#fff','left'); txt(['Gesang','Sprache','Aus'][music.voiceMode()],R.x+R.w-18,cy2,20,music.voiceMode()===2?'#ff9a8a':'#9be05a','right'); }
        else if(id==='voicesel'){ txt('Stimme',R.x+18,cy2,20,'#fff','left'); txt((music.voiceIdx()+1)+' / '+music.voiceCount(),R.x+R.w-18,cy2,20,'#fff','right'); }
        else if(id==='cos'){
          txt('Kostüm',R.x+18,cy2,20,'#fff','left');
          tri(R.x+R.w-190,cyl,-1,9); tri(R.x+R.w-22,cyl,1,9);
          txt(COSTUMES[costume],R.x+R.w-106,cy2,20,'#ffd23f');
        }
        else if(id==='trail'||id==='shot'){
          var isT=id==='trail', anyU=isT?(UNL.trail[0]||UNL.trail[1]||UNL.trail[2]):(UNL.shot[0]||UNL.shot[1]);
          txt(isT?'Spur':'Bananen',R.x+18,cy2,20,'#fff','left');
          if(anyU){ tri(R.x+R.w-190,cyl,-1,9); tri(R.x+R.w-22,cyl,1,9); txt(isT?TRAILN[trailSel]:SHOTN[shotSel],R.x+R.w-106,cy2,20,'#ffd23f'); }
          else txt('Freischalten über Missionen',R.x+R.w-18,cy2,14,'rgba(255,255,255,.6)','right');
        }
      });
      btn(RR.back,'Zurück','','#8a5a2b',cur==='back');
      txt(touch?'Tippen oder Regler ziehen':'Pfeiltasten links/rechts ändern den Wert',320,396,14,'#fff');
    }
    if(menuMsgT>0){ ctx.globalAlpha=Math.min(1,menuMsgT*2); txt(menuMsg,320,state==='shop'?(shopTab===1?342:332):state==='code'?332:state==='main'?384:374,20,'#ffd23f'); ctx.globalAlpha=1; }
    ctx.restore();
  }
  function misSorted(){ var o=[], d=[]; MAIN.forEach(function(m){ if(m.grp) return; (MS.done[m.id]?d:o).push(m); }); return o.concat(d); }
  function misPages(){ return Math.ceil(misSorted().length/4); }
  function misRow(m,st,y,daily){
    var done=!!st.done[m.id], pr=mProg(m,st), R={x:20,y:y,w:600,h:30}, hard=!!m.u;
    rr(R.x,R.y,R.w,R.h,8); ctx.fillStyle=done?'rgba(60,140,70,.55)':(hard?'rgba(110,50,150,.6)':'rgba(30,60,100,.6)'); ctx.fill();
    ctx.lineWidth=1.5; ctx.strokeStyle=hard&&!done?'#c890ff':'rgba(255,255,255,.25)'; ctx.stroke();
    if(!done&&pr>0){ rr(R.x+2,R.y+R.h-5,(R.w-4)*pr/m.n,3,1.5); ctx.fillStyle=hard?'#e8a8ff':'#ffd23f'; ctx.fill(); }
    var label=daily?m.d:((hard?'★ ':'')+m.t+': '+m.d);
    txt(label,R.x+12,R.y+20,13,done?'#d8f0d8':'#fff','left');
    if(done) txt('✓ geschafft',R.x+R.w-12,R.y+20,13,'#9be05a','right');
    else {
      txt(fmt(pr)+' / '+fmt(m.n),R.x+R.w-(hard?200:72),R.y+20,12,'#fff','right');
      if(hard) txt(UNAMES[m.u],R.x+R.w-66,R.y+20,12,'#e8a8ff','right');
      txt('+'+m.b,R.x+R.w-12,R.y+20,13,'#ffd23f','right'); banana(R.x+R.w-46,R.y+14,0.3,0.6,true);
    }
  }
  function drawMissions(RR,cur){
    var i, dl=dailyList(), list=misSorted(), nd=0;
    list.forEach(function(m){ if(MS.done[m.id]) nd++; });
    txt('Missionen',24,40,30,'#fff','left'); badge(620,40,bananas);
    plate(RR.mtA,misTab===0?'#e6a800':'#6a5a3a',cur==='mtA'); txt('Aufgaben',RR.mtA.x+RR.mtA.w/2,RR.mtA.y+23,16);
    plate(RR.mtW,misTab===1?'#e6a800':'#6a5a3a',cur==='mtW'); txt('Welten',RR.mtW.x+RR.mtW.w/2,RR.mtW.y+23,16);
    if(misTab===1){ drawWorldMis(); btn(RR.back,'Zurück','','#8a5a2b',cur==='back'); return; }
    list=list.slice(); 
    txt('Tagesmissionen · neu ab Mitternacht',24,64,13,'#ffd23f','left');
    for(i=0;i<3;i++) misRow(dl[i],DS,70+i*34,true);
    txt('Hauptmissionen · '+nd+' von '+list.length+' geschafft',24,192,13,'#ffd23f','left');
    txt('★ = schwere Mission mit Freischaltung',616,192,11,'#e8a8ff','right');
    for(i=0;i<4;i++){ var m=list[misPage*4+i]; if(m) misRow(m,MS,198+i*36,false); }
    plate(RR.mprev,'#4a7de0',cur==='mprev'); tri(RR.mprev.x+RR.mprev.w/2-3,RR.mprev.y+RR.mprev.h/2,-1,9);
    plate(RR.mnext,'#4a7de0',cur==='mnext'); tri(RR.mnext.x+RR.mnext.w/2+3,RR.mnext.y+RR.mnext.h/2,1,9);
    txt('Seite '+(misPage+1)+' / '+misPages(),510,371,15,'#fff');
    btn(RR.back,'Zurück','','#8a5a2b',cur==='back');
  }
  function drawWorldMis(){
    var w, d, nd=0, tot=WNAMES.length*3, y0=72, rh=20.5, CX=[372,462,552];
    for(w=1;w<=WNAMES.length;w++) for(d=0;d<3;d++) if(isClr(w,d)) nd++;
    txt('Jede Welt in jeder Stufe schaffen · '+nd+' von '+tot,24,62,13,'#ffd23f','left');
    for(d=0;d<3;d++) txt(DIFFS[d].name,CX[d],62,12,'#fff');
    for(w=1;w<=WNAMES.length;w++){
      var yy=y0+(w-1)*rh, R={x:20,y:yy,w:600,h:rh-2.5};
      rr(R.x,R.y,R.w,R.h,6); ctx.fillStyle=worldOpen(w)?'rgba(30,60,100,.6)':'rgba(30,30,40,.6)'; ctx.fill();
      txt(w+'  '+WNAMES[w-1],R.x+10,yy+13.5,12,worldOpen(w)?'#fff':'rgba(255,255,255,.5)','left');
      for(d=0;d<3;d++){
        var cx=CX[d], cy=yy+8.5;
        if(isClr(w,d)){ bL('#9be05a',3,[cx-6,cy,cx-1,cy+5,cx+7,cy-5]); }
        else if(isUnl(w,d)){ txt('+'+(50+10*(w-1)+50*d),cx-6,cy+5,12,'#ffd23f'); banana(cx+16,cy+1,0.3,0.42,true); }
        else lockIcon(cx,cy+1,9,'rgba(255,255,255,.55)');
      }
    }
  }
  function drawPause(){
    var F=frame(), it=uiItems(), RR={}, cur=it[sel]?it[sel].id:'';
    it.forEach(function(q){ RR[q.id]=q.r; });
    ctx.fillStyle='rgba(10,20,15,0.55)'; ctx.fillRect(0,0,W,Hw);
    ctx.save(); ctx.translate(F.x,F.y);
    txt('Pause',320,118,46);
    btn(RR.resume,'Weiter','','#5fbf4a',cur==='resume');
    btn(RR.tomain,'Hauptmenü','','#e6a800',cur==='tomain');
    ctx.restore();
  }

  function loop(ts){
    var dt=Math.min(0.033,(ts-last)/1000||0); last=ts; t+=dt;
    update(dt); draw(); raf=requestAnimationFrame(loop);
  }
  function gp(e){ var r=cv.getBoundingClientRect(); return {x:(e.clientX-r.left)/scale,y:(e.clientY-r.top)/scale}; }
  cv.addEventListener('pointerdown',function(e){
    e.preventDefault(); music.start();
    var g=gp(e), i;
    if(isMenuState()||state==='pause'){ var h=uiHit(g); if(h){ sel=h.i; uiActivate(h.it.id,g); } return; }
    if(state==='dead'||state==='win'){
      if(t-endAt>0.6){ var E=endRects(); if(inR(E[1],g)) toMenu(); else startGame(di); }
      return;
    }
    if(state==='play'&&inR(pauseRect(),g)){ pauseGame(); return; }
    if(specAvail()&&inR(specRect(),g)){ fireSpecial(); return; }
    if(giantReady()&&inR(giantRect(),g)){ activateGiant(); return; }
    if(e.pointerType==='touch'&&e.clientX>window.innerWidth*0.5&&state==='play'){ chargeId=e.pointerId; aDown(); }
    else press();
  });
  cv.addEventListener('pointermove',function(e){
    if(dragVol){ setVolFromX(gp(e).x-frame().x); return; }
    if((!isMenuState()&&state!=='pause')||e.pointerType==='touch') return;
    var hh=uiHit(gp(e)); if(hh) sel=hh.i;
  });
  function pointerEnd(e){ dragVol=false; if(chargeId!==null&&e.pointerId===chargeId){ chargeId=null; aUp(); } }
  window.addEventListener('pointerup',pointerEnd);
  window.addEventListener('pointercancel',pointerEnd);
  window.addEventListener('resize',function(){ if(raf) resize(); });
  window.addEventListener('blur',function(){ charging=false; chargeT=0; chargeId=null; });
  function isA(e){ return (e.key==='a'||e.key==='A')&&!e.ctrlKey&&!e.metaKey&&!e.altKey; }
  document.addEventListener('keydown',function(e){
    if(!raf) return;
    var k=e.key; music.start();
    if(k==='Escape'){ e.preventDefault(); if(!e.repeat) uiBack(); return; }
    if(state==='code'){
      if(/^[0-9]$/.test(k)){ e.preventDefault(); codeKey(k); return; }
      if(k==='Backspace'){ e.preventDefault(); codeKey('del'); return; }
      if(k==='Enter'){ e.preventDefault(); if(!e.repeat) codeKey('ok'); return; }
    }
    if(isMenuState()||state==='pause'){
      if(k==='ArrowUp'||k==='ArrowDown'||k==='ArrowLeft'||k==='ArrowRight'){ e.preventDefault(); uiKey(k); return; }
      if(k==='Enter'||e.code==='Space'||k===' '){ e.preventDefault(); if(!e.repeat) press(); return; }
      if(state==='world'&&/^[0-9]$/.test(k)){ e.preventDefault(); uiActivate('w'+(k==='0'?10:+k),null); return; }
      if(state==='menu'&&(k==='1'||k==='2'||k==='3')){ e.preventDefault(); tryStart(+k-1); return; }
    }
    if(e.code==='Space'||k===' '){ e.preventDefault(); if(!e.repeat) press(); }
    else if(k==='Enter'&&(state==='dead'||state==='win')){ e.preventDefault(); if(!e.repeat) press(); }
    else if((k==='p'||k==='P')&&!e.repeat&&(state==='play'||state==='pause')){ e.preventDefault(); uiBack(); }
    else if((state==='dead'||state==='win')&&(k==='d'||k==='D')&&t-endAt>0.4){ e.preventDefault(); toMenu(); }
    else if(isA(e)){ e.preventDefault(); if(!e.repeat) aDown(); }
    else if((k==='m'||k==='M')&&!e.repeat&&!e.ctrlKey&&!e.metaKey&&!e.altKey){ e.preventDefault(); toggleMusic(); }
    else if((k==='v'||k==='V')&&!e.repeat&&!e.ctrlKey&&!e.metaKey&&!e.altKey){ e.preventDefault(); toggleVoice(); }
    else if((k==='s'||k==='S')&&!e.repeat&&!e.ctrlKey&&!e.metaKey&&!e.altKey){ e.preventDefault(); fireSpecial(); }
    else if((k==='r'||k==='R'||k==='w'||k==='W')&&!e.repeat&&!e.ctrlKey&&!e.metaKey&&!e.altKey){ e.preventDefault(); activateGiant(); }
    else if((k==='b'||k==='B')&&!e.repeat&&!e.ctrlKey&&!e.metaKey&&!e.altKey){ e.preventDefault(); nextVoice(); }
  });
  document.addEventListener('keyup',function(e){
    if(!raf) return;
    if(e.code==='Space'||e.key===' ') e.preventDefault();
    if(e.key==='a'||e.key==='A') aUp();
  });
  document.addEventListener('visibilitychange',function(){ if(document.hidden){ saveMis(); music.pause(); if(state==='play') pauseGame(); } else music.resume(); });
  resize(); diff=DIFFS[di]; reset(); state='main'; sel=0; last=performance.now(); raf=requestAnimationFrame(loop);
  cv.focus();
})();
</script>
</body>
</html>
