          bC(x+8,wy+36,10,pal.sun); bL('#0a0614',3,[x,wy+6,x,wy+146]); bL('#0a0614',3,[x-28,wy+80,x+28,wy+80]);
          var fx=x+150, fy=GROUND-170; bR(fx-30,fy,60,74,'#8a6a2a',3); bR(fx-24,fy+6,48,62,'#3a2a4a',2); bC(fx,fy+30,13,'#6a5a7a'); bE(fx,fy+60,18,10,'#5a4a6a');
          var lx=Math.max(-2,Math.min(2,(px-fx)/120)); bC(fx-5,fy+28,3,'#fff'); bC(fx+5,fy+28,3,'#fff'); bC(fx-5+lx,fy+28,1.5,'#111'); bC(fx+5+lx,fy+28,1.5,'#111');
